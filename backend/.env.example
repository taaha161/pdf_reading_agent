# Google Gemini API key (for extraction, categorization, chat, and scanned-PDF vision).
# If unset, Ollama is used for text/chat when available; vision is skipped.
# Get a key: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_GEMINI_API_KEY=
DATALAB_API_KEY=
API_AUTH_SECRET=
# Supabase (auth + DB). Create a project at https://supabase.com
# IMPORTANT: Backend SUPABASE_URL must match frontend VITE_SUPABASE_URL (same project).
# Project Settings → API: Project URL. JWT verification uses JWKS (new signing keys; no legacy JWT secret).
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key from Project Settings → API (required only for account deletion: DELETE /api/account).
SUPABASE_SERVICE_ROLE_KEY=

# Database: Supabase → Project Settings → Database → Connection string.
# If "could not translate host name db.xxx.supabase.co" appears, use the Connection pooling (Transaction) URI instead of Direct; the pooler host (e.g. aws-0-xx.pooler.supabase.com) often resolves better on local networks.
DATABASE_URL=

# Optional: comma-separated frontend origins for CORS (e.g. https://bankstatementscanner.com).
# If unset, localhost and default production origins are allowed.
ALLOWED_ORIGINS=

# Optional: set to 1 (or true/yes) in production to enable HSTS and stricter security headers.
# PRODUCTION=1

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default: INFO.
# LOG_LEVEL=INFO

# Optional: Redis URL for shared rate-limit storage across instances (e.g. redis://localhost:6379/0).
# If unset, rate limits use in-memory storage (fine for single instance).
# REDIS_URL=

# Stripe (billing). Create products/prices at https://dashboard.stripe.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=   # From Stripe CLI or Dashboard → Webhooks
# STRIPE_PRICE_ID_MONTHLY= # Recurring $10/month price id (e.g. price_xxx)
# STRIPE_PRICE_ID_TOPUP=   # One-time $10 top-up price id (e.g. price_xxx)
# FRONTEND_URL=http://localhost:5173  # For Checkout success/cancel return URLs