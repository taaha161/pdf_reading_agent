# Backend API URL. Served to the client at runtime via /api/config (not embedded in bundle).
API_URL=

# Supabase (auth). Create a project at https://supabase.com
# Project Settings → API: Project URL.
# Use the new Publishable key (sb_publishable_...) from API Keys tab (not Legacy API Keys).
# These are served at runtime via /api/config on Vercel; for local dev, set here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# reCAPTCHA v3 site key (public). Served via /api/config; must pair with backend RECAPTCHA_SECRET_KEY.
RECAPTCHA_SITE_KEY=

# Google Drive picker ("Upload from Google Drive"). Leave blank to hide the button.
# Google Cloud Console: enable "Google Picker API" + "Google Drive API";
# Credentials → OAuth client ID (Web; add your site to Authorized JavaScript origins),
# an API key restricted to the Picker API + your site's HTTP referrers,
# and the project NUMBER (IAM & Admin → Settings) as GOOGLE_APP_ID. Scope used: drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# Optional: base path for assets (e.g. /pdf_reading_agent/ for GitHub Pages).
# BASE_PATH=/

# Public site URL for SEO (canonical, og:url, sitemap). No trailing slash.
# e.g. https://bankstatementscanner.com
# If unset, the app falls back to window.location.origin at runtime.
# VITE_PUBLIC_SITE_URL=

# TikTok Events API (server-side signup + Get started / ClickButton). Generate token in TikTok Events Manager → pixel → Events API.
# TIKTOK_EVENTS_ACCESS_TOKEN=
# Optional override if different from the pixel in index.html:
# TIKTOK_PIXEL_CODE=

# Contact form (/contact) — server-side only (Vercel → api/contact.js). https://resend.com
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=team@bankstatementscanner.com
# Verified sender in Resend (use onboarding@resend.dev only for testing; verify your domain for production).
# CONTACT_FROM_EMAIL=Bank Statement Scanner <onboarding@resend.dev>

# Error monitoring (Sentry), read at BUILD time. Blank disables it.
# Create a React project at sentry.io and paste its DSN (DSNs are public by design).
VITE_SENTRY_DSN=
# Optional: upload source maps on build so stack traces show real code.
# They're deleted from dist after upload, never served publicly.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
