# Backend API URL. Served to the client at runtime via /api/config (not embedded in bundle).
API_URL=

# Supabase (auth). Create a project at https://supabase.com
# Project Settings → API: Project URL.
# Use the new Publishable key (sb_publishable_...) from API Keys tab (not Legacy API Keys).
# These are served at runtime via /api/config on Vercel; for local dev, set here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: base path for assets (e.g. /pdf_reading_agent/ for GitHub Pages).
# BASE_PATH=/
