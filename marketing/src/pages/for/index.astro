---
/** Hub for persona landing pages so /for resolves and every persona page has an indexable parent. */
import Base from '../../layouts/Base.astro';
import { PERSONAS } from '../../personas';
import { canonical } from '../../consts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Who Uses Bank Statement Scanner',
    url: canonical('/for'),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: PERSONAS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.seoTitle, url: canonical(`/for/${p.slug}`) })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonical('/') },
      { '@type': 'ListItem', position: 2, name: "Who it's for", item: canonical('/for') },
    ],
  },
];
---

<Base
  title="Bank Statement Conversion for Every Workflow"
  description="How accountants, bookkeepers, tax preparers, small business owners, and real estate teams turn bank statement PDFs into Excel and CSV."
  path="/for"
  jsonLd={jsonLd}
>
  <section class="container fori">
    <h1>Who uses Bank Statement Scanner</h1>
    <p class="fori-lede">
      Everyone who works from bank statements ends up re-typing them. Pick your workflow to see how PDF statements become
      clean Excel or CSV files for it.
    </p>
    <ul class="fori-grid" role="list">
      {PERSONAS.map((p) => (
        <li>
          <a href={`/for/${p.slug}`}>
            <span class="fori-title">{p.name}</span>
            <span class="fori-body">{p.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="fori-note">
      Looking for a specific bank? See <a href="/convert">supported banks</a>. Weighing other tools? See
      <a href="/compare">comparisons</a>.
    </p>
  </section>
</Base>

<style>
  .fori { max-width: 900px; padding-block: 48px 24px; }
  .fori h1 { font-size: clamp(30px, 5vw, 42px); margin: 0 0 14px; }
  .fori-lede { font-size: 18px; line-height: 1.65; color: var(--color-text-muted); max-width: 640px; margin: 0 0 32px; }
  .fori-note { margin-top: 36px; font-size: 15px; color: var(--color-text-muted); }
  .fori-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .fori-grid a {
    display: flex; flex-direction: column; gap: 6px; padding: 20px; height: 100%;
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    background: var(--color-surface); color: var(--color-text); text-decoration: none;
  }
  .fori-grid a:hover { border-color: var(--color-primary); box-shadow: var(--shadow-sm); }
  .fori-title { font-family: var(--font-heading); font-size: 21px; font-weight: 600; }
  .fori-body { font-size: 15px; color: var(--color-text-muted); line-height: 1.55; }
</style>
