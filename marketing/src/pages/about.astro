---
import Base from '../layouts/Base.astro';
import {
  SITE_URL, SITE_NAME, SITE_DESCRIPTION, SUPPORT_EMAIL, LEGAL_ENTITY, SAME_AS, canonical,
  FREE_ANON_PAGES, FREE_LABEL,
} from '../consts';

const audiences = [
  {
    title: 'Accountants and bookkeepers',
    body: 'Turn a stack of client statements into clean, categorized rows for reconciliation, catch-up work, and tax prep instead of retyping them.',
    href: '/for/accountants',
  },
  {
    title: 'Small business owners',
    body: 'Get months of transactions into Excel or your accounting software, even when the bank only offers PDFs or a short download window.',
    href: '/blog/bank-statement-scanner-for-small-businesses',
  },
  {
    title: 'Individuals',
    body: 'Budget, track subscriptions, or prepare a loan or visa application from statements you already have.',
    href: '/blog/bank-statement-scanner-for-personal-finance',
  },
];

const profileName = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, '');
  const names: Record<string, string> = {
    'linkedin.com': 'LinkedIn', 'x.com': 'X', 'twitter.com': 'X', 'facebook.com': 'Facebook',
    'youtube.com': 'YouTube', 'instagram.com': 'Instagram', 'github.com': 'GitHub',
    'producthunt.com': 'Product Hunt', 'crunchbase.com': 'Crunchbase', 'wikidata.org': 'Wikidata',
    'g2.com': 'G2', 'trustpilot.com': 'Trustpilot',
  };
  return names[host] ?? host;
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${SITE_NAME}`,
    url: canonical('/about'),
    mainEntity: {
      '@type': 'Organization',
      name: SITE_NAME,
      legalName: LEGAL_ENTITY,
      url: `${SITE_URL}/`,
      logo: `${SITE_URL}/og-image.png`,
      description: SITE_DESCRIPTION,
      email: SUPPORT_EMAIL,
      ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonical('/') },
      { '@type': 'ListItem', position: 2, name: 'About', item: canonical('/about') },
    ],
  },
];
---

<Base
  title="About Us"
  description={`Who we are and what we do: ${SITE_NAME} turns bank statement PDFs into clean Excel and CSV data for accountants, bookkeepers, small businesses, and individuals.`}
  path="/about"
  jsonLd={jsonLd}
>
  <section class="container about">
    <nav class="about-crumbs" aria-label="Breadcrumb"><a href="/">← Back to home</a></nav>

    <header class="about-head">
      <p class="eyebrow">About us</p>
      <h1>We turn bank statements into data you can use.</h1>
      <p class="lede">
        {SITE_NAME} is a web app that reads bank and credit card statement PDFs, digital or scanned, and
        exports every transaction as a clean, categorized Excel or CSV file. Then you can ask the AI for exactly
        the transactions you need and download just those.
      </p>
    </header>

    <div class="about-body">
      <h2>Who we are</h2>
      <p>
        {SITE_NAME} is built and run by <strong>{LEGAL_ENTITY}</strong>, a small software company. Banks hand
        out statements as PDFs, but bookkeeping, tax prep, and budgeting happen in spreadsheets and accounting
        software. Retyping one into the other is slow and error-prone, so we built the bridge.
      </p>

      <h2>What we do</h2>
      <p>
        Upload a statement and we extract the date, description, amount, and running balance of every
        transaction, check the totals against the statement's opening and closing balances, and categorize each
        row. You get a file ready for Excel, Google Sheets, QuickBooks, or Xero. Try {FREE_ANON_PAGES} pages
        without an account, or sign up for {FREE_LABEL}. See <a href="/#pricing">pricing</a>.
      </p>
      <p>
        Your statements are sensitive, so we treat them that way: encrypted in transit, an incognito mode that
        keeps nothing, and deletion on request. Read how on our <a href="/security">security page</a> and in
        our <a href="/privacy-policy">privacy policy</a>.
      </p>

      <h2>Who it's for</h2>
    </div>

    <div class="about-grid">
      {audiences.map((a) => (
        <a class="about-card" href={a.href}>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </a>
      ))}
    </div>

    <div class="about-body">
      <h2>Get in touch</h2>
      <p>
        Questions, feedback, or a statement we don't read well? Email
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or use our <a href="/contact">contact form</a>.
        A real person answers. For guides and updates, read the <a href="/blog">blog</a> or subscribe to its
        <a href="/rss.xml">RSS feed</a>.
      </p>
      {SAME_AS.length > 0 && (
        <p>
          Find us on:{' '}
          {SAME_AS.map((url, i) => (
            <>
              {i > 0 && ' · '}
              <a href={url} rel="me noopener" target="_blank">{profileName(url)}</a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>
</Base>

<style>
  .about { max-width: 900px; padding-block: 40px 64px; }
  .about-crumbs { margin-bottom: 24px; font-size: 14px; }
  .about-head { max-width: 680px; margin-bottom: 32px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 13px; font-weight: 600; color: var(--color-primary); margin: 0 0 10px; }
  .about-head h1 { font-size: clamp(30px, 5vw, 44px); margin: 0; }
  .lede { color: var(--color-text-muted); font-size: 18px; line-height: 1.6; margin-top: 14px; }
  .about-body { max-width: 720px; }
  .about-body h2 { font-size: 22px; margin: 32px 0 12px; }
  .about-body p { color: var(--color-text-muted); font-size: 16px; line-height: 1.7; margin: 0 0 14px; }
  .about-body strong { color: var(--color-text); }
  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .about-card {
    display: block; text-decoration: none; color: inherit;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm);
  }
  .about-card:hover { box-shadow: var(--shadow-md); }
  .about-card h3 { font-size: 18px; margin: 0 0 8px; }
  .about-card p { color: var(--color-text-muted); font-size: 15px; margin: 0; line-height: 1.6; }
</style>
