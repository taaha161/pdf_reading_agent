---
import Base from '../layouts/Base.astro';
import rawContent from '../legal/privacy-policy.html?raw';
---

<Base
  title="Privacy Policy"
  description="How Bank Statement Scanner collects, uses, and protects your information when you convert bank statement PDFs."
  path="/privacy-policy"
>
  <article class="container legal">
    <nav class="legal-crumbs" aria-label="Breadcrumb"><a href="/">← Back to home</a></nav>
    <div class="legal-content" set:html={rawContent} />
  </article>
</Base>

<style>
  .legal { max-width: 820px; padding-block: 40px 24px; }
  .legal-crumbs { margin-bottom: 24px; font-size: 14px; }
  .legal-content :global(*) { max-width: 100%; }
  .legal-content :global(table) { display: block; overflow-x: auto; }
</style>
