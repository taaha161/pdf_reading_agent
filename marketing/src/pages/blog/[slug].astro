---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_URL, SITE_NAME, OG_IMAGE, AUTHOR, canonical } from '../../consts';
import { postFaqs } from '../../lib/postFaqs';
import { relatedPosts } from '../../lib/relatedPosts';
import HeroDropzone from '../../components/HeroDropzone.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// Topically related posts plus the next-older post, so internal links spread
// across the whole archive instead of all pointing at the newest posts.
const related = relatedPosts(post, await getCollection('blog'));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const isoDate = data.date.toISOString().slice(0, 10);
const url = canonical(`/blog/${post.id}`);
const imageAbs = `${SITE_URL}${data.image}`;
const faqs = postFaqs(post.body);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.excerpt,
    datePublished: isoDate,
    dateModified: isoDate,
    image: imageAbs,
    author: {
      '@type': 'Person',
      name: AUTHOR.name,
      url: AUTHOR.url,
      worksFor: { '@type': 'Organization', name: AUTHOR.org, url: AUTHOR.url },
    },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: OG_IMAGE },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonical('/') },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: canonical('/blog') },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  ...(faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.excerpt}
  path={`/blog/${post.id}`}
  ogType="article"
  ogImage={imageAbs}
  appendSiteName={false}
  jsonLd={jsonLd}
>
  <article class="container post">
    <nav class="post-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog">Blog</a>
    </nav>

    <div class="post-image">
      <img src={data.image} alt="" width="1120" height="560" fetchpriority="high" />
    </div>

    <div class="post-meta">
      <span class="post-cat">{data.category}</span>
      <time datetime={isoDate}>{fmt(data.date)}</time>
      <span class="post-read">{data.readTime}</span>
    </div>

    <h1 class="post-title">{data.title}</h1>

    <p class="post-byline">
      By <a href={AUTHOR.url} rel="author" target="_blank">{AUTHOR.name}</a>
      <span aria-hidden="true">·</span> {AUTHOR.org}
    </p>

    {
      data.converter && (
        <div class="post-tool">
          <HeroDropzone cta="blog_tool" hint="Try it on your own statement: drop a PDF and get the rows in seconds. No account needed." />
        </div>
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <aside class="post-author" aria-label="About the author">
      <p>
        Written by <a href={AUTHOR.url} rel="author" target="_blank"><strong>{AUTHOR.name}</strong></a>
        at <a href={AUTHOR.url} target="_blank">{AUTHOR.org}</a>, the team behind {SITE_NAME}.
      </p>
    </aside>

    <nav class="post-foot" aria-label="Blog navigation">
      <a href="/blog">← All posts</a>
      <a href="/scanner" class="post-foot-cta">Convert a statement →</a>
    </nav>

    <aside class="post-related" aria-label="Related guides">
      <h2>Related guides</h2>
      <ul role="list">
        {
          related.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </article>
</Base>

<style>
  .post { max-width: 760px; padding-block: 40px 24px; }
  .post-crumbs {
    display: flex; gap: 8px; align-items: center; font-size: 14px;
    color: var(--color-text-muted); margin-bottom: 24px;
  }
  .post-crumbs span { color: var(--color-border); }
  .post-image {
    border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 28px;
    aspect-ratio: 2 / 1; background: var(--color-primary-subtle);
  }
  .post-image img { width: 100%; height: 100%; object-fit: cover; }
  .post-meta {
    display: flex; align-items: center; gap: 14px; font-size: 14px;
    color: var(--color-text-muted); margin-bottom: 12px;
  }
  .post-cat { color: var(--color-primary); font-weight: 600; }
  .post-title { font-size: clamp(28px, 4.5vw, 40px); margin: 0 0 12px; }
  .post-byline { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 15px; color: var(--color-text-muted); margin: 0 0 28px; }
  .post-byline a { font-weight: 600; color: var(--color-text); }
  .post-author { margin-top: 40px; padding: 18px 20px; background: var(--color-primary-subtle); border-radius: var(--radius-lg); font-size: 16px; }
  .post-author p { margin: 0; }
  .post-author a { color: var(--color-text); }
  .post-body :global(h3) { font-size: 20px; margin: 28px 0 8px; line-height: 1.3; }

  .post-body { font-size: 18px; line-height: 1.72; color: #1e293b; }
  .post-body :global(h2) {
    font-size: 25px; margin: 40px 0 12px; line-height: 1.25;
  }
  .post-body :global(p) { margin: 0 0 20px; }
  .post-body :global(strong) { color: var(--color-text); }

  .post-foot {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--color-border);
  }
  .post-foot a { font-weight: 600; }
  .post-tool { max-width: 560px; margin: 8px 0 32px; }
  .post-foot-cta {
    background: var(--color-primary); color: var(--color-on-primary);
    padding: 10px 18px; border-radius: var(--radius-md);
  }
  .post-foot-cta:hover { background: var(--color-primary-hover); color: var(--color-on-primary); }

  .post-related { margin-top: 40px; }
  .post-related h2 { font-size: 20px; margin: 0 0 14px; }
  .post-related ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .post-related a { font-weight: 600; color: var(--color-primary); }
  .post-related a:hover { color: var(--color-primary-hover); }
</style>
