---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" path="/404" noindex={true}>
  <section class="container" style="padding-block: 96px; text-align: center;">
    <p style="font-family: var(--font-heading); font-size: 72px; color: var(--color-primary); margin: 0;">404</p>
    <h1 style="font-size: 28px; margin-top: 8px;">We couldn't find that page</h1>
    <p style="color: var(--color-text-muted); margin-top: 12px;">
      The page may have moved. Try the homepage or the blog.
    </p>
    <p style="margin-top: 28px; display: flex; gap: 12px; justify-content: center;">
      <a href="/" style="font-weight:600;">Home</a>
      <span aria-hidden="true" style="color: var(--color-border);">·</span>
      <a href="/blog" style="font-weight:600;">Blog</a>
      <span aria-hidden="true" style="color: var(--color-border);">·</span>
      <a href="/scanner" style="font-weight:600;">Convert a statement</a>
    </p>
  </section>
</Base>
