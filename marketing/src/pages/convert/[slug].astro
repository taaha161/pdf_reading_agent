---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_NAME, canonical } from '../../consts';

export async function getStaticPaths() {
  const banks = await getCollection('banks');
  return banks.map((bank) => ({ params: { slug: bank.data.slug }, props: { bank } }));
}

const { bank } = Astro.props;
const b = bank.data;

const otherBanks = (await getCollection('banks'))
  .filter((x) => x.id !== bank.id)
  .sort((x, y) => x.data.name.localeCompare(y.data.name));

const related = b.relatedPost
  ? (await getCollection('blog')).find((p) => p.id === b.relatedPost)
  : undefined;

const path = `/convert/${b.slug}`;
const url = canonical(path);
const reviewedIso = b.reviewed.toISOString().slice(0, 10);
const reviewedLabel = b.reviewed.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const convertSteps = [
  {
    title: 'Upload the PDF',
    body: `Drop in a ${b.shortName} statement: a digital PDF, a scan, or a password-protected file.`,
  },
  {
    title: 'Review the transactions',
    body: 'Dates, descriptions, amounts, and credit or debit appear in a table, categorized automatically. Ask the built-in assistant to check anything that looks off.',
  },
  {
    title: 'Export CSV or Excel',
    body: 'Download a CSV for QuickBooks, Xero, or other accounting tools, or an Excel file for review and analysis.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: b.seoTitle,
    description: b.description,
    url,
    dateModified: reviewedIso,
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: canonical('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonical('/') },
      { '@type': 'ListItem', position: 2, name: 'Supported banks', item: canonical('/convert') },
      { '@type': 'ListItem', position: 3, name: b.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: b.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={b.seoTitle} description={b.description} path={path} jsonLd={jsonLd}>
  <article class="container bank">
    <nav class="bank-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/convert">Supported banks</a>
      <span aria-hidden="true">/</span>
      <span class="bank-crumbs-here">{b.name}</span>
    </nav>

    <header class="bank-hero">
      <p class="bank-eyebrow">{b.name} statement converter</p>
      <h1>Convert {b.name} statements to Excel and CSV</h1>
      <p class="bank-intro">{b.intro}</p>
      <div class="bank-cta-row">
        <a class="bank-btn" href="/scanner">Convert a {b.shortName} statement free</a>
        <span class="bank-cta-note">5 statements free · No credit card</span>
      </div>
      <dl class="bank-facts">
        <div><dt>Statements</dt><dd>{b.statementTypes.join(' · ')}</dd></div>
        <div><dt>Input</dt><dd>Digital PDF · Scanned · Password-protected</dd></div>
        <div><dt>Export</dt><dd>CSV · Excel (XLSX)</dd></div>
      </dl>
    </header>

    <section class="bank-section">
      <h2>Why not just use {b.shortName}'s own download?</h2>
      <p>{b.exportLimits}</p>
    </section>

    <section class="bank-section">
      <h2>How to download your {b.name} statement PDF</h2>
      <ol class="bank-steps">
        {b.downloadSteps.map((s) => <li>{s}</li>)}
      </ol>
      <p class="bank-small">Menu names change from time to time. If a label doesn't match, look for “Statements” on the account page.</p>
    </section>

    <section class="bank-section">
      <h2>Convert it in three steps</h2>
      <ol class="bank-howto" role="list">
        {
          convertSteps.map((s, i) => (
            <li>
              <span class="bank-howto-n">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="bank-section">
      <h2>What to know about {b.name} statement layouts</h2>
      <div class="bank-notes">
        {
          b.layoutNotes.map((n) => (
            <div class="bank-note">
              <h3>{n.title}</h3>
              <p>{n.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bank-section bank-check">
      <h2>Check your export before you import it</h2>
      <p>
        Every statement prints an opening and a closing balance. Add up the credits and debits in your
        export: <strong>opening balance + credits − debits</strong> should equal the closing balance. If it
        doesn't, compare the row count with the statement to find a missing or duplicated line. This takes
        a minute, and it catches the silent errors that copy-paste and general AI chatbots make.
      </p>
    </section>

    <section class="bank-section">
      <h2>{b.name} statement conversion FAQ</h2>
      <div class="bank-faq">
        {
          b.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="bank-final">
      <h2>Turn your {b.shortName} PDFs into a spreadsheet</h2>
      <p>Upload a statement and export clean rows in under a minute. Use incognito mode if you don't want anything saved.</p>
      <a class="bank-btn" href="/scanner">Upload a {b.shortName} statement</a>
    </section>

    <footer class="bank-foot">
      {
        related && (
          <p>
            More detail: <a href={`/blog/${related.id}`}>{related.data.title}</a>
          </p>
        )
      }
      <div class="bank-sources">
        <h2>Sources</h2>
        <p class="bank-small">
          Bank menus and download limits are based on the sources below and reviewed on
          <time datetime={reviewedIso}>{reviewedLabel}</time>. {SITE_NAME} isn't affiliated with {b.name}.
        </p>
        <ul>
          {b.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </div>
      <nav class="bank-others" aria-label="Other banks">
        <h2>Other banks</h2>
        <ul role="list">
          {otherBanks.map((o) => <li><a href={`/convert/${o.data.slug}`}>{o.data.name}</a></li>)}
        </ul>
      </nav>
    </footer>
  </article>
</Base>

<style>
  .bank { max-width: 820px; padding-block: 40px 24px; }
  .bank-crumbs {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 14px;
    color: var(--color-text-muted); margin-bottom: 28px;
  }
  .bank-crumbs span[aria-hidden] { color: var(--color-border); }
  .bank-crumbs-here { color: var(--color-text); }

  .bank-hero { display: flex; flex-direction: column; gap: 16px; margin-bottom: 16px; }
  .bank-eyebrow {
    margin: 0; color: var(--color-primary); font-weight: 600; font-size: 14px;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .bank-hero h1 { font-size: clamp(30px, 5vw, 44px); margin: 0; }
  .bank-intro { font-size: 19px; line-height: 1.65; color: #1e293b; margin: 0; }
  .bank-cta-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bank-btn {
    display: inline-block; font-weight: 600; font-size: 16px; padding: 12px 22px;
    border-radius: var(--radius-md); text-align: center; text-decoration: none;
    background: var(--color-primary); color: var(--color-on-primary);
  }
  .bank-btn:hover { background: var(--color-primary-hover); color: var(--color-on-primary); }
  .bank-cta-note { font-size: 14px; color: var(--color-text-muted); }
  .bank-facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;
    margin: 8px 0 0; padding: 16px; border: 1px solid var(--color-border);
    border-radius: var(--radius-md); background: var(--color-surface);
  }
  .bank-facts dt {
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-text-muted); margin-bottom: 2px;
  }
  .bank-facts dd { margin: 0; font-size: 15px; font-weight: 500; }

  .bank-section { margin-top: 48px; }
  .bank-section h2, .bank-final h2 { font-size: 26px; margin: 0 0 14px; line-height: 1.25; }
  .bank-section p { font-size: 17px; line-height: 1.7; margin: 0 0 14px; color: #1e293b; }
  .bank-small { font-size: 14px !important; color: var(--color-text-muted) !important; }

  .bank-steps { margin: 0 0 12px; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; font-size: 17px; }

  .bank-howto { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .bank-howto li { display: flex; gap: 12px; align-items: flex-start; }
  .bank-howto-n {
    flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-primary-subtle); color: var(--color-primary); font-weight: 700;
  }
  .bank-howto h3, .bank-note h3 { font-family: var(--font-body); font-size: 17px; margin: 4px 0 6px; }
  .bank-howto p { font-size: 15px !important; margin: 0 !important; }

  .bank-notes { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .bank-note {
    padding: 18px; border: 1px solid var(--color-border); border-radius: var(--radius-md);
    background: var(--color-surface); min-width: 0;
  }
  .bank-note p { font-size: 15.5px !important; margin: 0 !important; }

  .bank-check {
    padding: 22px; border-radius: var(--radius-lg); background: var(--color-primary-subtle);
  }
  .bank-check p { margin: 0 !important; }

  .bank-faq { display: flex; flex-direction: column; }
  .bank-faq details { border-bottom: 1px solid var(--color-border); padding: 14px 0; }
  .bank-faq summary { cursor: pointer; font-weight: 600; font-size: 17px; }
  .bank-faq details p { margin: 10px 0 0 !important; }

  .bank-final {
    margin-top: 56px; padding: 32px; text-align: center; border-radius: var(--radius-lg);
    border: 1px solid var(--color-border); background: var(--color-surface);
  }
  .bank-final p { color: var(--color-text-muted); margin: 0 auto 18px; max-width: 520px; }

  .bank-foot { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--color-border); display: grid; gap: 28px; }
  .bank-foot h2 { font-size: 18px; margin: 0 0 10px; }
  .bank-sources ul { margin: 8px 0 0; padding-left: 20px; font-size: 14px; display: grid; gap: 4px; }
  .bank-sources a { overflow-wrap: anywhere; }
  .bank-others ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .bank-others a { font-weight: 600; }
</style>
