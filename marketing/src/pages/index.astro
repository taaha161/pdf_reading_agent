---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BankLogoMarquee from '../components/BankLogoMarquee.astro';
import HeroDropzone from '../components/HeroDropzone.astro';
import ConvertDemo from '../components/ConvertDemo.astro';
import ProductVideo from '../components/ProductVideo.astro';
import SecurityStrip from '../components/SecurityStrip.astro';
import AskStatement from '../components/AskStatement.astro';
import SampleExport from '../components/SampleExport.astro';
import FounderBlock from '../components/FounderBlock.astro';
import StickyCta from '../components/StickyCta.astro';
import { comparePages } from '../comparePages';
import { SITE_URL, SITE_NAME, SITE_TAGLINE, SUPPORT_EMAIL, FREE_STATEMENTS, canonical } from '../consts';

// Use-case cards pull from the real blog posts.
const posts = await getCollection('blog');
const bySlug = (s: string) => posts.find((p) => p.id === s)!;
const useCases = [
  { slug: 'bank-statement-scanner-for-accountants', label: 'For accountants', persona: '/for/accountants' },
  { slug: 'bank-statement-scanner-for-small-businesses', label: 'For small business', persona: undefined as string | undefined },
  { slug: 'bank-statement-scanner-for-personal-finance', label: 'For personal finance', persona: undefined as string | undefined },
].map((u) => ({ ...u, post: bySlug(u.slug) }));

const banks = (await getCollection('banks')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const faqs = [
  {
    q: 'How does Bank Statement Scanner work?',
    a: 'Upload any bank or credit card statement PDF. Our AI extracts transaction dates, descriptions, and amounts, applies smart categorization, and lets you export clean, structured data to CSV or Excel in seconds.',
  },
  {
    q: 'Which banks and institutions are supported?',
    a: 'Bank Statement Scanner supports Chase, Wells Fargo, American Express, and 100+ other banks and card issuers. It handles both digital PDFs and scanned paper statements.',
  },
  {
    q: 'What export formats are available?',
    a: 'You can export your extracted, categorized transactions as CSV (ideal for importing into QuickBooks, Xero, or other tools) or Excel (XLSX) for review, annotation, and analysis.',
  },
  {
    q: 'How much does Bank Statement Scanner cost?',
    a: `Bank Statement Scanner offers a $10/month subscription that adds $10 in credits each billing cycle. Credits are used per scan, from less than 1¢ to $1.50 depending on mode. You can also add one-time credit top-ups. Your first ${FREE_STATEMENTS} statements are free, no credit card required.`,
  },
  {
    q: 'Can I ask the AI for specific transactions?',
    a: 'Yes. After a statement is converted, open the chat and ask in plain English, for example "Give me all transactions from John" or "Show every ATM withdrawal in March". You get the matching rows with exact totals, plus a one-click download of just those transactions as Excel or CSV.',
  },
  {
    q: 'Can I see the output before uploading my own statement?',
    a: 'Yes. Open the sample export on this page to see a fictional statement next to the spreadsheet we produced from it, and download the Excel and CSV files. You can also open the same sample inside the scanner without uploading anything.',
  },
  {
    q: 'Is my financial data secure?',
    a: 'Yes. Bank Statement Scanner uses bank-grade security. You can also use incognito mode to process statements without saving them to your account.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    description:
      'Turn messy bank statements into structured data in seconds. Upload a PDF and export clean, categorized transactions to CSV or Excel.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    url: `${SITE_URL}/`,
    // No `offers` here: a SoftwareApplication/WebApplication with offers is
    // required by Google/Semrush to also carry aggregateRating or review, and
    // we won't fabricate ratings. Pricing is communicated in the visible
    // pricing section instead.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/og-image.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      email: SUPPORT_EMAIL,
      contactType: 'customer support',
      url: canonical('/contact'),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

// Headline A/B test (home_h1). Variant B is the outcome-led line from the LinkedIn LP.
const H1_VARIANTS = {
  a: 'Turn bank statement PDFs into <span class="accent">clean, categorized data</span> in seconds.',
  b: 'Never type a bank statement into <span class="accent">Excel</span> again.',
};

const steps = [
  { title: 'Drop in the PDF', body: 'Any bank or credit card statement: digital, scanned, or password-protected.' },
  { title: 'AI does the typing', body: 'Every date, payee and amount is extracted and sorted into a category.' },
  { title: 'Check and export', body: 'Balances are checked against the statement. Download Excel or CSV for QuickBooks, Xero or your workbook.' },
];

---

<Base title={`${SITE_NAME} — ${SITE_TAGLINE}`} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero" data-sticky-after>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="pill">New: ask your statement for any transactions</p>
        <h1 class="hero-title" id="home-h1" set:html={H1_VARIANTS.a} />
        <script is:inline define:vars={{ H1_VARIANTS }}>
          // Sticky 50/50 split by cookie; reported to GTM so conversions can be compared per variant.
          (function () {
            try {
              var m = document.cookie.match(/(?:^|; )bss_h1=([ab])/);
              var v = m ? m[1] : (Math.random() < 0.5 ? 'a' : 'b');
              if (!m) document.cookie = 'bss_h1=' + v + '; path=/; max-age=' + 60 * 60 * 24 * 60 + '; samesite=lax';
              if (v === 'b') document.getElementById('home-h1').innerHTML = H1_VARIANTS.b;
              (window.dataLayer = window.dataLayer || []).push({ event: 'experiment_view', experiment: 'home_h1', variant: v });
              if (window.clarity) window.clarity('set', 'home_h1', v);
            } catch (e) {}
          })();
        </script>
        <p class="hero-sub">
          Upload a bank, credit card, or scanned statement. Get every transaction back in clean,
          categorized columns, checked against the statement's balances, ready for Excel, CSV,
          QuickBooks, or Xero. Then ask for exactly what you need, like every payment from John, and
          download just those rows.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/scanner" data-cta="hero_primary">Get started free</a>
          <a class="btn btn-ghost" href="#sample" data-open-sample="hero" data-cta="hero_sample">View sample export</a>
        </div>
        <p class="hero-meta">
          <span>No credit card required</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{FREE_STATEMENTS} statements free</span>
          <span class="dot" aria-hidden="true"></span>
          <span>No annual contract</span>
        </p>
        <div class="hero-trust">
          <div class="hero-avatars" aria-hidden="true">
            <img src="/avatars/avatar-1.jpg" alt="" width="36" height="36" />
            <img src="/avatars/avatar-2.jpg" alt="" width="36" height="36" />
            <img src="/avatars/avatar-3.jpg" alt="" width="36" height="36" />
            <span class="hero-avatars-badge">10k+</span>
          </div>
          <span class="hero-trust-label">Trusted by 10,000+ finance professionals</span>
        </div>
      </div>

      <div class="hero-mock">
        <HeroDropzone />
        <p class="hero-sample-link">
          Not ready to upload your own? <a href="/scanner?sample=1" data-cta="hero_try_sample">Try it with a sample statement →</a>
        </p>
      </div>
    </div>
  </section>

  <SecurityStrip />

  <BankLogoMarquee />

  <!-- Results / stats -->
  <section class="results" id="results" aria-label="Results">
    <div class="container stats">
      <div><div class="stat-value">10k+</div><div class="stat-label">Finance professionals</div></div>
      <div><div class="stat-value">8 hrs</div><div class="stat-label">Saved per client</div></div>
      <div><div class="stat-value">Up to 100%</div><div class="stat-label">Extraction accuracy</div></div>
    </div>
  </section>

  <!-- Product video -->
  <section class="watch" id="demo" aria-labelledby="watch-h">
    <div class="container watch-inner">
      <div class="section-head">
        <h2 id="watch-h">See it work in 22 seconds</h2>
        <p>Drop in a PDF. Every transaction comes back categorized and checked against the balances, ready for Excel or CSV.</p>
      </div>
      <ProductVideo />
      <div class="watch-actions">
        <a class="btn btn-primary" href="/scanner" data-cta="video_primary">Try it free with your statement</a>
        <a class="btn btn-ghost" href="/scanner?sample=1" data-cta="video_sample">Try it with a sample</a>
      </div>
      <p class="watch-credit">Music: “Happy Beats / Business Moves Vol. 11” by Sascha Ende (ende.app), CC BY 4.0.</p>
    </div>
  </section>

  <!-- How it works: show the output, then the three steps -->
  <section class="how" id="how-it-works" aria-label="How it works">
    <div class="container how-inner">
      <div class="how-demo">
        <ConvertDemo video />
      </div>
      <div class="how-copy">
        <h2>From PDF to spreadsheet in three steps</h2>
        <ol class="how-steps" role="list">
          {steps.map((st, i) => (
            <li>
              <span class="how-n">{i + 1}</span>
              <div><h3>{st.title}</h3><p>{st.body}</p></div>
            </li>
          ))}
        </ol>
        <div class="how-actions">
          <a class="btn btn-primary" href="/scanner" data-cta="how_primary">Convert a statement free</a>
          <a class="btn btn-ghost" href="#sample" data-open-sample="how" data-cta="how_sample">See a real export</a>
        </div>
      </div>
    </div>
  </section>

  <AskStatement cta="home_ask" tone="tint" />

  <!-- Features -->
  <section class="features" aria-label="Features">
    <div class="container">
      <header class="section-head">
        <h2>Convert it, ask it, export it</h2>
        <p>Our AI does the heavy lifting so you can focus on making informed financial decisions.</p>
      </header>
      <div class="feature-grid">
        <article class="feature-card feature-card--new">
          <span class="feature-new">New</span>
          <h3>Ask your statement</h3>
          <p>Ask for “all transactions from John” or “every ATM withdrawal” and download just those rows as Excel or CSV.</p>
        </article>
        <article class="feature-card">
          <h3>AI-powered extraction</h3>
          <p>Instantly pull line-item data from any computer-generated or scanned PDF with high accuracy.</p>
        </article>
        <article class="feature-card">
          <h3>Smart categorization</h3>
          <p>Automatically group transactions by merchant, type, and description using custom rules and AI categorization.</p>
        </article>
        <article class="feature-card">
          <h3>Secure &amp; private</h3>
          <p>Bank-grade security. Use incognito mode to process statements without saving them. <a href="/security">Read about security →</a></p>
        </article>
        <article class="feature-card">
          <h3>Export to any format</h3>
          <p>Download your structured, categorized data as CSV or Excel—ready for QuickBooks, Xero, or a spreadsheet.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="usecases-wrap" aria-label="Who it's for">
    <div class="container">
      <header class="section-head">
        <h2>Built for whoever is typing statements today</h2>
      </header>
      <div class="usecases">
        {
          useCases.map((u) => (
            <article class="usecard">
              <a class="usecard-media" href={`/blog/${u.slug}`}>
                <img src={u.post.data.image} alt="" loading="lazy" width="480" height="270" />
              </a>
              <div class="usecard-body">
                <h3>{u.label}</h3>
                <p>{u.post.data.excerpt}</p>
                <a class="usecard-link" href={u.persona ?? `/blog/${u.slug}`}>{u.persona ? `See how it works for ${u.label.replace(/^For /, '')}` : `Read the ${u.label.replace(/^For /, '')} guide`} →</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing" aria-label="Pricing">
    <div class="container">
      <header class="section-head">
        <h2>Simple, pay-as-you-go pricing</h2>
        <p>Start with {FREE_STATEMENTS} free statements. Then $10 a month, monthly, no annual contract. Cancel anytime.</p>
      </header>
      <div class="price-grid">
        <article class="price-card price-card--highlight">
          <div class="price-pill">Most popular</div>
          <div class="price-label">Monthly subscription</div>
          <div class="price-value">$10<span>/mo</span></div>
          <p class="price-tagline">$10 of scan credit every month. What that gets you:</p>
          <ul class="price-examples" role="list">
            <li><strong>~10</strong><span>statements on Balanced</span></li>
            <li><strong>~6</strong><span>statements on Accurate</span></li>
            <li><strong>1,000+</strong><span>pages on Fast</span></li>
          </ul>
          <ul class="price-list">
            <li>Mix modes per statement: Fast from &lt;1¢, Balanced $1, Accurate $1.50</li>
            <li>CSV &amp; Excel export, AI categorization</li>
            <li>Top up anytime for extra credits</li>
            <li>Monthly billing, cancel anytime</li>
          </ul>
          <a class="btn btn-primary price-btn" href="/scanner" data-cta="pricing_sub">Start with {FREE_STATEMENTS} free statements</a>
        </article>
        <article class="price-card">
          <div class="price-label">Optional top-up</div>
          <div class="price-value price-value--custom">Add credits</div>
          <p class="price-tagline">Busy month? Add a one-time top-up, with or without a subscription.</p>
          <ul class="price-list">
            <li>One-time credit purchases</li>
            <li>Same per-statement prices as the plan</li>
            <li>Same export &amp; categorization features</li>
            <li>Works alongside your monthly plan</li>
          </ul>
          <a class="btn btn-outline price-btn" href="/scanner" data-cta="pricing_topup">Try it free first</a>
        </article>
      </div>
    </div>
  </section>

  <FounderBlock />

  <!-- FAQ -->
  <section class="faq" id="faq" aria-label="Frequently asked questions">
    <div class="container faq-inner">
      <header class="section-head">
        <h2>Frequently asked questions</h2>
        <p>Everything you need to know before your first upload. Still stuck? <a href="/contact">Contact support</a>.</p>
      </header>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band" aria-label="Call to action">
    <div class="container cta-band-inner">
      <h2>Ready to stop manual data entry?</h2>
      <p>Join 10,000+ finance professionals who turn messy statements into clean, structured data with Bank Statement Scanner.</p>
      <div class="cta-band-actions">
        <a class="btn btn-invert" href="/scanner" data-cta="band">Start scanning now</a>
        <span class="cta-band-note">{FREE_STATEMENTS} statements free · No credit card required.</span>
      </div>
    </div>
  </section>

  <!-- Resources: kept below the pitch so they don't pull visitors away mid-page -->
  <section class="resources" aria-label="Resources">
    <div class="container res-grid">
      <div>
        <h2>Guides for your bank</h2>
        <ul role="list">
          {banks.map((b) => <li><a href={`/convert/${b.data.slug}`}>{b.data.name}</a></li>)}
          <li><a href="/convert">All supported banks →</a></li>
        </ul>
      </div>
      <div>
        <h2>How we compare</h2>
        <ul role="list">
          {comparePages.filter((c) => c.featured).map((c) => <li><a href={c.href}>{c.title}</a></li>)}
          <li><a href="/compare">All comparisons →</a></li>
        </ul>
      </div>
      <div>
        <h2>Who it's for</h2>
        <ul role="list">
          <li><a href="/for/accountants">Accountants &amp; CPA firms</a></li>
          <li><a href="/for/bookkeepers">Bookkeepers</a></li>
          {useCases.map((u) => <li><a href={`/blog/${u.slug}`}>{u.post.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <SampleExport />
  <StickyCta note={`${FREE_STATEMENTS} statements free · No card`} />
</Base>

<style>
  .btn {
    display: inline-block; font-weight: 600; font-size: 16px;
    padding: 12px 22px; border-radius: var(--radius-md); cursor: pointer;
    border: 1px solid transparent; text-align: center;
  }
  .btn-primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn-primary:hover { background: var(--color-primary-hover); color: var(--color-on-primary); }
  .btn-ghost { background: transparent; color: var(--color-text); border-color: var(--color-border); }
  .btn-ghost:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .btn-outline { background: transparent; color: var(--color-primary); border-color: var(--color-primary-muted); }
  .btn-outline:hover { background: var(--color-primary-subtle); color: var(--color-primary); }
  .btn-invert { background: #fff; color: var(--color-primary); }
  .btn-invert:hover { color: var(--color-primary-hover); }

  .section-head { max-width: 640px; margin: 0 auto 40px; text-align: center; }
  .section-head h2 { font-size: clamp(26px, 4vw, 36px); margin: 0; }
  .section-head p { color: var(--color-text-muted); font-size: 17px; margin-top: 12px; }

  /* Hero */
  .hero { background: var(--landing-bg); padding-block: 64px 40px; }
  .hero-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; }
  .pill {
    display: inline-block; background: var(--color-primary-subtle); color: var(--color-primary);
    font-weight: 600; font-size: 13px; padding: 6px 14px; border-radius: 999px; margin: 0 0 18px;
  }
  .hero-title { font-size: clamp(34px, 5.4vw, 52px); margin: 0; line-height: 1.08; }
  .accent { color: var(--color-primary); }
  .hero-sub { font-size: 18px; color: var(--color-text-muted); margin-top: 20px; max-width: 54ch; }
  .hero-actions { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .hero-trust { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 22px; }
  .hero-avatars { display: inline-flex; align-items: center; }
  .hero-avatars img {
    width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--color-surface); box-shadow: var(--shadow-sm);
  }
  .hero-avatars img + img, .hero-avatars-badge { margin-left: -10px; }
  .hero-avatars-badge {
    display: inline-grid; place-items: center; height: 36px; min-width: 36px; padding: 0 9px;
    border-radius: 999px; border: 2px solid var(--color-surface);
    background: var(--color-primary); color: var(--color-on-primary); font-size: 12px; font-weight: 700;
  }
  .hero-trust-label { font-size: 15px; font-weight: 600; color: var(--color-text); }
  .hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; color: var(--color-text-muted); font-size: 14px; margin-top: 22px; }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--color-border); display: inline-block; }

  .hero-sample-link { margin: 14px 0 0; text-align: center; font-size: 14px; color: var(--color-text-muted); }
  .hero-sample-link a { font-weight: 600; }

  /* Results */
  .results { padding-block: 36px; border-bottom: 1px solid var(--color-border); }
  .stats { display: flex; gap: 48px; justify-content: center; flex-wrap: wrap; text-align: center; }
  .stat-value { font-family: var(--font-heading); font-size: 34px; color: var(--color-primary); }
  .stat-label { color: var(--color-text-muted); font-size: 14px; margin-top: 4px; }

  /* Product video */
  .watch { padding-block: 72px 0; }
  .watch-inner { max-width: 1000px; }
  .watch .section-head { margin-bottom: 28px; }
  .watch-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  .watch-credit { margin: 14px 0 0; text-align: center; font-size: 12px; color: var(--color-text-muted); }

  /* How it works */
  .how { padding-block: 80px 24px; }
  .how-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .how-copy h2 { font-size: clamp(26px, 4vw, 36px); margin: 0 0 24px; }
  .how-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .how-steps li { display: flex; gap: 16px; align-items: flex-start; }
  .how-n {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-primary); color: #fff; font-weight: 700;
  }
  .how-steps h3 { margin: 4px 0 4px; font-size: 18px; }
  .how-steps p { margin: 0; color: var(--color-text-muted); font-size: 15px; }
  .how-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }

  /* Features */
  .features { padding-block: 72px; }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; }
  .feature-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm);
  }
  .feature-card h3 { font-size: 19px; margin: 0 0 8px; }
  .feature-card--new { position: relative; border-color: var(--color-primary-muted); box-shadow: var(--shadow-md); }
  .feature-new {
    position: absolute; top: -10px; right: 18px; padding: 3px 10px; border-radius: 999px;
    background: linear-gradient(135deg, var(--color-primary), #7c3aed); color: #fff;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .feature-card p { color: var(--color-text-muted); font-size: 15px; margin: 0; }

  /* Use cases */
  .usecases-wrap { padding-bottom: 8px; }
  .usecases { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; padding-bottom: 8px; }
  .usecard {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);
  }
  .usecard-media { display: block; aspect-ratio: 16 / 9; background: var(--color-primary-subtle); }
  .usecard-media img { width: 100%; height: 100%; object-fit: cover; }
  .usecard-body { padding: 20px 22px; }
  .usecard-body h3 { margin: 0 0 8px; font-size: 20px; }
  .usecard-body p { color: var(--color-text-muted); font-size: 15px; margin: 0 0 14px; }
  .usecard-link { font-weight: 600; }

  /* Resources */
  .resources { padding-block: 56px; background: var(--color-bg); border-top: 1px solid var(--color-border); }
  .res-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .res-grid h2 { font-size: 16px; margin: 0 0 12px; }
  .res-grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; }
