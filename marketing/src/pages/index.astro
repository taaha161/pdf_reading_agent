---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_URL, SITE_NAME, SITE_TAGLINE, SUPPORT_EMAIL, canonical } from '../consts';

// Use-case cards pull from the real blog posts.
const posts = await getCollection('blog');
const bySlug = (s: string) => posts.find((p) => p.id === s)!;
const useCases = [
  { slug: 'bank-statement-scanner-for-accountants', label: 'For accountants' },
  { slug: 'bank-statement-scanner-for-small-businesses', label: 'For small business' },
  { slug: 'bank-statement-scanner-for-personal-finance', label: 'For personal finance' },
].map((u) => ({ ...u, post: bySlug(u.slug) }));

const faqs = [
  {
    q: 'How does Bank Statement Scanner work?',
    a: 'Upload any bank or credit card statement PDF. Our AI extracts transaction dates, descriptions, and amounts, applies smart categorization, and lets you export clean, structured data to CSV or Excel in seconds.',
  },
  {
    q: 'Which banks and institutions are supported?',
    a: 'Bank Statement Scanner supports Chase, Wells Fargo, American Express, and 100+ other banks and card issuers. It handles both digital PDFs and scanned paper statements.',
  },
  {
    q: 'What export formats are available?',
    a: 'You can export your extracted, categorized transactions as CSV (ideal for importing into QuickBooks, Xero, or other tools) or Excel (XLSX) for review, annotation, and analysis.',
  },
  {
    q: 'How much does Bank Statement Scanner cost?',
    a: 'Bank Statement Scanner offers a $10/month subscription that adds $10 in credits each billing cycle. Credits are used per scan, from less than 1¢ to $1.50 depending on mode. You can also add one-time credit top-ups. No credit card required to try.',
  },
  {
    q: 'Is my financial data secure?',
    a: 'Yes. Bank Statement Scanner uses bank-grade security. You can also use incognito mode to process statements without saving them to your account.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    description:
      'Turn messy bank statements into structured data in seconds. Upload a PDF and export clean, categorized transactions to CSV or Excel.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    url: `${SITE_URL}/`,
    offers: {
      '@type': 'Offer',
      price: '10.00',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '10.00',
        priceCurrency: 'USD',
        unitText: 'month',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/og-image.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      email: SUPPORT_EMAIL,
      contactType: 'customer support',
      url: canonical('/contact'),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={`${SITE_NAME} — ${SITE_TAGLINE}`} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="pill">AI-powered bank statement scanner</p>
        <h1 class="hero-title">
          Turn bank statement PDFs into <span class="accent">clean, categorized data</span> in seconds.
        </h1>
        <p class="hero-sub">
          AI-powered extraction and smart categorization turn any bank, credit card, or PDF
          statement into clean, categorized CSVs—so you get structured data you can trust, not
          just raw line items.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/scanner">Get started free</a>
          <a class="btn btn-ghost" href="/scanner">View sample export</a>
        </div>
        <p class="hero-meta">
          <span>No credit card required</span>
          <span class="dot" aria-hidden="true"></span>
          <span>Upload up to 5 statements free</span>
        </p>
      </div>

      <div class="hero-mock">
        <a class="upload-card" href="/scanner" aria-label="Upload bank statements — opens the converter">
          <span class="upload-badge">Drag &amp; drop bank statements</span>
          <span class="upload-sub">PDF, scans, or photos</span>
          <span class="upload-drop">
            <span class="upload-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M12 14V4m0 0l-3.5 3.5M12 4l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 14.5v3A2.5 2.5 0 006.5 20h11A2.5 2.5 0 0020 17.5v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="upload-title">Drop files to get started</span>
            <span class="upload-hint">Supports Chase, Wells Fargo, Amex, and 100+ more institutions.</span>
            <span class="btn btn-primary upload-btn">Upload PDF for free</span>
            <span class="upload-limits"><span>MAX 50MB</span> · <span>Computer-generated or scanned PDF only</span></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Results / stats -->
  <section class="results" id="results" aria-label="Results">
    <div class="container stats">
      <div><div class="stat-value">12k+</div><div class="stat-label">Finance teams</div></div>
      <div><div class="stat-value">8 hrs</div><div class="stat-label">Saved per client</div></div>
      <div><div class="stat-value">Up to 100%</div><div class="stat-label">Extraction accuracy</div></div>
    </div>
  </section>

  <!-- How it works / features -->
  <section class="features" id="how-it-works" aria-label="How it works">
    <div class="container">
      <header class="section-head">
        <h2>Powerful features for seamless finance</h2>
        <p>Our AI does the heavy lifting so you can focus on making informed financial decisions.</p>
      </header>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>AI-powered extraction</h3>
          <p>Instantly pull line-item data from any computer-generated or scanned PDF with high accuracy.</p>
        </article>
        <article class="feature-card">
          <h3>Smart categorization</h3>
          <p>Automatically group transactions by merchant, type, and description using custom rules and AI categorization.</p>
        </article>
        <article class="feature-card">
          <h3>Secure &amp; private</h3>
          <p>Bank-grade security. Use incognito mode to process statements without saving them. <a href="/security">Read about security →</a></p>
        </article>
        <article class="feature-card">
          <h3>Export to any format</h3>
          <p>Download your structured, categorized data as CSV or Excel—ready for QuickBooks, Xero, or a spreadsheet.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="usecases container" aria-label="Use cases">
    {
      useCases.map((u) => (
        <article class="usecard">
          <a class="usecard-media" href={`/blog/${u.slug}`}>
            <img src={u.post.data.image} alt="" loading="lazy" width="480" height="270" />
          </a>
          <div class="usecard-body">
            <h3>{u.label}</h3>
            <p>{u.post.data.excerpt}</p>
            <a class="usecard-link" href={`/blog/${u.slug}`}>Learn more →</a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- CTA band -->
  <section class="cta-band" aria-label="Call to action">
    <div class="container cta-band-inner">
      <h2>Ready to stop manual data entry?</h2>
      <p>Join thousands of firms who turn messy statements into clean, structured data with Bank Statement Scanner.</p>
      <div class="cta-band-actions">
        <a class="btn btn-invert" href="/scanner">Start scanning now</a>
        <span class="cta-band-note">No credit card required.</span>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing" aria-label="Pricing">
    <div class="container">
      <header class="section-head">
        <h2>Simple, pay-as-you-go pricing</h2>
        <p>Subscribe monthly and $10 is added to your credit each month. Optionally top up anytime for extra credits. No long-term commitment.</p>
      </header>
      <div class="price-grid">
        <article class="price-card price-card--highlight">
          <div class="price-pill">Most popular</div>
          <div class="price-label">Monthly subscription</div>
          <div class="price-value">$10<span>/mo</span></div>
          <p class="price-tagline">$10 in credit added to your account every month. Use credits per scan—pay only for what you use.</p>
          <ul class="price-list">
            <li>$10 credit added each billing cycle</li>
            <li>Credits used per scan (from &lt;1¢ to $1.50 depending on mode)</li>
            <li>Optionally top up anytime for extra credits</li>
            <li>CSV &amp; Excel export, AI categorization—cancel anytime</li>
          </ul>
          <a class="btn btn-primary price-btn" href="/login">Get started</a>
        </article>
        <article class="price-card">
          <div class="price-label">Optional top-up</div>
          <div class="price-value price-value--custom">Add credits</div>
          <p class="price-tagline">Need more credits? Add a one-time top-up anytime—with or without a subscription.</p>
          <ul class="price-list">
            <li>One-time credit purchases</li>
            <li>Fast mode from &lt;1¢, balanced $1, accurate $1.50 per scan</li>
            <li>Same export &amp; categorization features</li>
            <li>Works alongside your monthly plan</li>
          </ul>
          <a class="btn btn-outline price-btn" href="/login">Get started</a>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ (now rendered on-page, previously only in schema) -->
  <section class="faq" id="faq" aria-label="Frequently asked questions">
    <div class="container faq-inner">
      <header class="section-head">
        <h2>Frequently asked questions</h2>
        <p>Everything you need to know before your first upload. Still stuck? <a href="/contact">Contact support</a>.</p>
      </header>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .btn {
    display: inline-block; font-weight: 600; font-size: 16px;
    padding: 12px 22px; border-radius: var(--radius-md); cursor: pointer;
    border: 1px solid transparent; text-align: center;
  }
  .btn-primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn-primary:hover { background: var(--color-primary-hover); color: var(--color-on-primary); }
  .btn-ghost { background: transparent; color: var(--color-text); border-color: var(--color-border); }
  .btn-ghost:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .btn-outline { background: transparent; color: var(--color-primary); border-color: var(--color-primary-muted); }
  .btn-outline:hover { background: var(--color-primary-subtle); color: var(--color-primary); }
  .btn-invert { background: #fff; color: var(--color-primary); }
  .btn-invert:hover { color: var(--color-primary-hover); }

  .section-head { max-width: 640px; margin: 0 auto 40px; text-align: center; }
  .section-head h2 { font-size: clamp(26px, 4vw, 36px); margin: 0; }
  .section-head p { color: var(--color-text-muted); font-size: 17px; margin-top: 12px; }

  /* Hero */
  .hero { background: var(--landing-bg); padding-block: 64px 40px; }
  .hero-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; }
  .pill {
    display: inline-block; background: var(--color-primary-subtle); color: var(--color-primary);
    font-weight: 600; font-size: 13px; padding: 6px 14px; border-radius: 999px; margin: 0 0 18px;
  }
  .hero-title { font-size: clamp(34px, 5.4vw, 52px); margin: 0; line-height: 1.08; }
  .accent { color: var(--color-primary); }
  .hero-sub { font-size: 18px; color: var(--color-text-muted); margin-top: 20px; max-width: 54ch; }
  .hero-actions { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .hero-meta { display: flex; align-items: center; gap: 12px; color: var(--color-text-muted); font-size: 14px; margin-top: 22px; }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--color-border); display: inline-block; }

  .upload-card {
    display: flex; flex-direction: column; gap: 4px; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 20px; box-shadow: var(--shadow-lg); color: inherit;
  }
  .upload-card:hover { color: inherit; box-shadow: var(--shadow-lg); }
  .upload-badge { font-weight: 600; }
  .upload-sub { font-size: 13px; color: var(--color-text-muted); }
  .upload-drop {
    display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;
    border: 2px dashed var(--color-primary-muted); border-radius: var(--radius-md);
    padding: 28px 20px; margin-top: 12px; background: var(--color-primary-subtle);
  }
  .upload-icon { color: var(--color-primary); }
  .upload-title { font-weight: 600; }
  .upload-hint { font-size: 13px; color: var(--color-text-muted); max-width: 34ch; }
  .upload-btn { margin-top: 6px; }
  .upload-limits { font-size: 12px; color: var(--color-text-muted); margin-top: 4px; }

  /* Results */
  .results { padding-block: 36px; border-bottom: 1px solid var(--color-border); }
  .stats { display: flex; gap: 48px; justify-content: center; flex-wrap: wrap; text-align: center; }
  .stat-value { font-family: var(--font-heading); font-size: 34px; color: var(--color-primary); }
  .stat-label { color: var(--color-text-muted); font-size: 14px; margin-top: 4px; }

  /* Features */
  .features { padding-block: 72px; }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; }
  .feature-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm);
  }
  .feature-card h3 { font-size: 19px; margin: 0 0 8px; }
  .feature-card p { color: var(--color-text-muted); font-size: 15px; margin: 0; }

  /* Use cases */
  .usecases { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; padding-bottom: 8px; }
  .usecard {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);
  }
  .usecard-media { display: block; aspect-ratio: 16 / 9; background: var(--color-primary-subtle); }
  .usecard-media img { width: 100%; height: 100%; object-fit: cover; }
  .usecard-body { padding: 20px 22px; }
  .usecard-body h3 { margin: 0 0 8px; font-size: 20px; }
  .usecard-body p { color: var(--color-text-muted); font-size: 15px; margin: 0 0 14px; }
  .usecard-link { font-weight: 600; }

  /* CTA band */
  .cta-band { background: var(--color-primary); color: #fff; margin-top: 72px; padding-block: 56px; }
  .cta-band-inner { text-align: center; }
  .cta-band h2 { font-size: clamp(26px, 4vw, 36px); margin: 0; color: #fff; }
  .cta-band p { margin: 12px auto 0; max-width: 52ch; color: rgba(255,255,255,0.9); }
  .cta-band-actions { display: flex; gap: 16px; align-items: center; justify-content: center; margin-top: 26px; flex-wrap: wrap; }
  .cta-band-note { font-size: 14px; color: rgba(255,255,255,0.85); }

  /* Pricing */
  .pricing { padding-block: 72px; }
  .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; max-width: 820px; margin-inline: auto; }
  .price-card {
    position: relative; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column;
  }
  .price-card--highlight { border-color: var(--color-primary); box-shadow: var(--shadow-md); }
  .price-pill {
    position: absolute; top: -12px; left: 28px; background: var(--color-primary); color: #fff;
    font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 999px;
  }
  .price-label { color: var(--color-text-muted); font-size: 14px; }
  .price-value { font-family: var(--font-heading); font-size: 40px; margin: 6px 0 4px; }
  .price-value span { font-size: 17px; color: var(--color-text-muted); }
  .price-value--custom { font-size: 28px; }
  .price-tagline { color: var(--color-text-muted); font-size: 15px; margin: 0 0 14px; }
  .price-list { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .price-list li { font-size: 15px; padding-left: 24px; position: relative; }
  .price-list li::before { content: "✓"; position: absolute; left: 0; color: var(--color-primary); font-weight: 700; }
  .price-btn { width: 100%; }

  /* FAQ */
  .faq { padding-block: 24px 72px; }
  .faq-inner { max-width: 760px; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 4px 20px;
  }
  .faq-item summary {
    cursor: pointer; font-weight: 600; font-size: 17px; padding: 16px 0; list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; color: var(--color-primary); font-size: 22px; font-weight: 400; }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item p { margin: 0 0 18px; color: var(--color-text-muted); font-size: 16px; line-height: 1.65; }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; }
  }
</style>
