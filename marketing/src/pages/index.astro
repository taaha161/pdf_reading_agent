---
import Base from '../layouts/Base.astro';
import { SITE_NAME, SITE_TAGLINE } from '../consts';
---

<Base title={`${SITE_NAME} — ${SITE_TAGLINE}`} path="/">
  <section class="container" style="padding-block: 64px;">
    <h1 style="font-size: clamp(32px, 6vw, 52px); max-width: 16ch;">
      Bank statements, sorted.
    </h1>
    <p style="font-size: 19px; color: var(--color-text-muted); max-width: 52ch; margin-top: 16px;">
      Upload a bank statement PDF to itemize, categorize, and validate
      transactions with AI — then export to CSV.
    </p>
    <p style="margin-top: 28px;">
      <a class="mkt-nav-cta" href="/scanner" style="display:inline-block; background: var(--color-primary); color:#fff; padding: 12px 22px; border-radius: var(--radius-md); font-weight:600;">
        Get started free
      </a>
    </p>
    <p style="margin-top: 40px; color: var(--color-text-muted); font-size:14px;">
      Scaffold placeholder — full landing port lands in Phase 3.
    </p>
  </section>
</Base>
