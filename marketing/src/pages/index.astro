---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BankLogoMarquee from '../components/BankLogoMarquee.astro';
import HeroDropzone from '../components/HeroDropzone.astro';
import ProductVideo from '../components/ProductVideo.astro';
import SecurityStrip from '../components/SecurityStrip.astro';
import StatementSheet from '../components/StatementSheet.astro';
import SampleExport from '../components/SampleExport.astro';
import FounderBlock from '../components/FounderBlock.astro';
import StickyCta from '../components/StickyCta.astro';
import { comparePages } from '../comparePages';
import {
  SITE_URL, SITE_NAME, SITE_TAGLINE, SUPPORT_EMAIL, LEGAL_ENTITY, SAME_AS, canonical,
  FREE_ANON_PAGES, FREE_SIGNUP_PAGES, FREE_SIGNUP_DAYS, FREE_LABEL, PLAN_PRICE, PLAN_PAGES, PAGE_PACKS, ACCURATE_MULTIPLIER, PRICING_SUMMARY,
} from '../consts';

// Use-case cards pull from the real blog posts.
const posts = await getCollection('blog');
const bySlug = (s: string) => posts.find((p) => p.id === s)!;
const useCases = [
  { slug: 'bank-statement-scanner-for-accountants', label: 'For accountants', persona: '/for/accountants' },
  { slug: 'bank-statement-scanner-for-small-businesses', label: 'For small business', persona: undefined as string | undefined },
  { slug: 'bank-statement-scanner-for-personal-finance', label: 'For personal finance', persona: undefined as string | undefined },
].map((u) => ({ ...u, post: bySlug(u.slug) }));

const banks = (await getCollection('banks')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const faqs = [
  {
    q: 'How does Bank Statement Scanner work?',
    a: 'Upload any bank or credit card statement PDF. Our AI extracts transaction dates, descriptions, and amounts, applies smart categorization, and lets you export clean, structured data to CSV or Excel in seconds.',
  },
  {
    q: 'Which banks and institutions are supported?',
    a: 'Bank Statement Scanner supports Chase, Wells Fargo, American Express, and 100+ other banks and card issuers. It handles both digital PDFs and scanned paper statements.',
  },
  {
    q: 'What export formats are available?',
    a: 'You can export your extracted, categorized transactions as CSV (ideal for importing into QuickBooks, Xero, or other tools) or Excel (XLSX) for review, annotation, and analysis.',
  },
  {
    q: 'How much does Bank Statement Scanner cost?',
    a: PRICING_SUMMARY,
  },
  {
    q: 'Can I ask the AI for specific transactions?',
    a: 'Yes. After a statement is converted, open the chat and ask in plain English, for example "Give me all transactions from John" or "Show every ATM withdrawal in March". You get the matching rows with exact totals, plus a one-click download of just those transactions as Excel or CSV.',
  },
  {
    q: 'Can I see the output before uploading my own statement?',
    a: 'Yes. Open the sample export on this page to see a fictional statement next to the spreadsheet we produced from it, and download the Excel and CSV files. You can also open the same sample inside the scanner without uploading anything.',
  },
  {
    q: 'Is my financial data secure?',
    a: 'Yes. Uploads and downloads are encrypted over HTTPS, and payments are handled by Stripe, so we never see your card. You can also use incognito mode to process a statement without saving it to your account.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    description:
      'Turn messy bank statements into structured data in seconds. Upload a PDF and export clean, categorized transactions to CSV or Excel.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    url: `${SITE_URL}/`,
    ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    // No `offers` here: a SoftwareApplication/WebApplication with offers is
    // required by Google/Semrush to also carry aggregateRating or review, and
    // we won't fabricate ratings. Pricing is communicated in the visible
    // pricing section instead.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/og-image.png`,
    legalName: LEGAL_ENTITY,
    ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    contactPoint: {
      '@type': 'ContactPoint',
      email: SUPPORT_EMAIL,
      contactType: 'customer support',
      url: canonical('/contact'),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

// Both headline texts from the retired home_h1 test stay: one opens the page, one closes it.
const HEADLINE = 'Turn bank statement PDFs into <span class="hl">clean, categorized data</span> in seconds.';
const CLOSING_HEADLINE = 'Never type a bank statement into Excel again.';

const steps = [
  { title: 'Drop in the PDF', body: 'Any bank or credit card statement: digital, scanned, or password-protected.' },
  { title: 'AI does the typing', body: 'Every date, payee and amount is extracted and sorted into a category.' },
  { title: 'Review and export', body: 'Look over the rows, then download Excel or CSV for QuickBooks, Xero or your workbook.' },
];

const features = [
  { title: 'Ask your statement', body: 'Ask for “all transactions from John” or “every ATM withdrawal” and download just those rows as Excel or CSV.', isNew: true },
  { title: 'AI-powered extraction', body: 'Instantly pull line-item data from any computer-generated or scanned PDF with high accuracy.' },
  { title: 'Smart categorization', body: 'Automatically group transactions by merchant, type, and description using custom rules and AI categorization.' },
  { title: 'Secure & private', body: 'Encrypted over HTTPS. Use incognito mode to process statements without saving them.', link: { href: '/security', label: 'Read about security' } },
  { title: 'Export to any format', body: 'Download your structured, categorized data as CSV or Excel, ready for QuickBooks, Xero, or a spreadsheet.' },
];
---

<Base title={`${SITE_NAME} — ${SITE_TAGLINE}`} path="/" jsonLd={jsonLd}>
  <!-- Hero: the statement on the desk, and the upload beside it -->
  <section class="hero" data-sticky-after>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title" set:html={HEADLINE} />
        <p class="hero-sub">
          Upload a bank, credit card, or scanned statement. Get every transaction back in clean,
          categorized columns, ready for Excel, CSV,
          QuickBooks, or Xero. Then ask for exactly what you need, like every payment from John, and
          download just those rows.
        </p>
        <div class="hero-upload">
          <HeroDropzone />
        </div>
        <p class="hero-sample">
          No statement handy? <a href="/scanner?sample=1" data-cta="hero_try_sample">Open the sample statement</a>
          or <a href="#sample" data-open-sample="hero" data-cta="hero_sample">see the exported files</a>.
        </p>
        <ul class="hero-meta tick-list" role="list">
          <li>No credit card required</li>
          <li>{FREE_LABEL}</li>
          <li>No annual contract</li>
        </ul>
      </div>
      <div class="hero-sheet">
        <StatementSheet />
      </div>
    </div>
  </section>

  <SecurityStrip />

  <BankLogoMarquee />

  <!-- How it works: the real product, then the three steps -->
  <section class="how" id="how-it-works" aria-labelledby="how-h">
    <div class="container how-grid">
      <div class="how-copy">
        <h2 id="how-h">From PDF to spreadsheet in three steps</h2>
        <ol class="how-steps" role="list">
          {steps.map((st, i) => (
            <li>
              <span class="how-n" aria-hidden="true">{i + 1}</span>
              <div><h3>{st.title}</h3><p>{st.body}</p></div>
            </li>
          ))}
        </ol>
        <div class="actions">
          <a class="ink-btn" href="/scanner" data-cta="how_primary">Convert a statement free</a>
          <a class="line-btn" href="#sample" data-open-sample="how" data-cta="how_sample">See the exported files</a>
        </div>
      </div>
      <div class="how-video" id="demo">
        <p class="how-video-note pencil" aria-hidden="true">See it work in 22 seconds</p>
        <ProductVideo />
      </div>
    </div>
  </section>

  <!-- What you get: set like a statement's account summary -->
  <section class="summary" aria-labelledby="summary-h">
    <div class="container">
      <div class="sheet summary-sheet">
        <header class="summary-head">
          <h2 id="summary-h">Convert it, ask it, export it</h2>
          <p>One upload gets you the rows, the categories and the answers, in a file you can open in Excel.</p>
        </header>
        <dl class="summary-list">
          {features.map((f) => (
            <div class="summary-row">
              <dt>{f.isNew ? <span class="hl">{f.title}</span> : f.title}{f.isNew && <span class="pencil summary-new">new</span>}</dt>
              <dd>
                {f.body}
                {f.link && <> <a href={f.link.href}>{f.link.label}</a></>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="who" aria-labelledby="who-h">
    <div class="container who-grid">
      <h2 id="who-h">Built for whoever is typing statements today</h2>
      <ul class="who-list" role="list">
        {useCases.map((u) => (
          <li>
            <h3>{u.label}</h3>
            <p>{u.post.data.excerpt}</p>
            <a href={u.persona ?? `/blog/${u.slug}`}>{u.persona ? `See how it works for ${u.label.replace(/^For /, '')}` : `Read the ${u.label.replace(/^For /, '')} guide`}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pricing: a fee schedule -->
  <section class="pricing" id="pricing" aria-labelledby="pricing-h">
    <div class="container">
      <div class="sheet fees">
        <header class="fees-head">
          <h2 id="pricing-h">Simple pricing, by the page</h2>
          <p>Try {FREE_ANON_PAGES} pages free without an account. Your first month includes {FREE_SIGNUP_PAGES} pages free. Then ${PLAN_PRICE} a month, no annual contract. Cancel anytime.</p>
        </header>
        <div class="fees-grid">
          <article class="fee">
            <h3 class="fee-label">Free</h3>
            <p class="fee-value">$0<span>/first month</span></p>
            <p class="fee-tagline">{FREE_SIGNUP_PAGES} pages free for your first {FREE_SIGNUP_DAYS} days. No credit card.</p>
            <ul class="fee-list tick-list" role="list">
              <li>{FREE_SIGNUP_PAGES} statement pages in your first month</li>
              <li>{FREE_ANON_PAGES} pages free even without an account</li>
              <li>CSV &amp; Excel export, AI categorization</li>
              <li>Ask your statements questions</li>
            </ul>
            <a class="line-btn fee-btn" href="/signup" data-cta="pricing_free">Create a free account</a>
          </article>
          <article class="fee fee--plan">
            <h3 class="fee-label">Monthly</h3>
            <p class="fee-value"><span class="hl">${PLAN_PRICE}</span><span>/mo</span><span class="fee-pencil pencil" aria-hidden="true">= $0.10 a page</span></p>
            <p class="fee-tagline">{PLAN_PAGES} pages every month. What that gets you:</p>
            <dl class="fee-examples">
              <div><dt>~16</dt><dd>six-page statements</dd></div>
              <div><dt>~8</dt><dd>six-page statements on High accuracy</dd></div>
              <div><dt>$0.10</dt><dd>per page</dd></div>
            </dl>
            <ul class="fee-list tick-list" role="list">
              <li>{PLAN_PAGES} pages each billing cycle</li>
              <li>Add page packs whenever you need more</li>
              <li>Larger uploads, up to 50 MB</li>
              <li>Monthly billing, cancel anytime</li>
            </ul>
            <a class="ink-btn fee-btn" href="/subscribe" data-cta="pricing_sub">Get Monthly</a>
            <p class="fee-fine">Pay securely with Stripe, then set your password.</p>
          </article>
          <article class="fee">
            <h3 class="fee-label">Page packs</h3>
            <p class="fee-value">from ${PAGE_PACKS[0].price}</p>
            <p class="fee-tagline">Busy month? Add pages anytime, with or without the plan.</p>
            <ul class="fee-list tick-list" role="list">
              {PAGE_PACKS.map((p) => <li>{p.pages} pages for ${p.price}</li>)}
              <li>Pack pages never expire</li>
              <li>High accuracy mode uses {ACCURATE_MULTIPLIER} pages per PDF page</li>
            </ul>
            <a class="line-btn fee-btn" href="/scanner" data-cta="pricing_topup">Convert a statement free</a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <FounderBlock />

  <!-- FAQ -->
  <section class="faq" id="faq" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <header class="faq-head">
        <h2 id="faq-h">Frequently asked questions</h2>
        <p>Everything you need to know before your first upload. Still stuck? <a href="/contact">Contact support</a>.</p>
      </header>
      <div class="sheet faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="close" aria-labelledby="close-h">
    <div class="container close-inner">
      <h2 id="close-h">{CLOSING_HEADLINE}</h2>
      <p>Turn messy statements into clean, structured data. Try your first {FREE_ANON_PAGES} pages without an account.</p>
      <div class="actions">
        <a class="ink-btn close-btn" href="/scanner" data-cta="band">Convert a statement free</a>
        <span class="close-note">{FREE_LABEL} · No credit card required.</span>
      </div>
    </div>
  </section>

  <!-- Resources: kept below the pitch so they don't pull visitors away mid-page -->
  <section class="resources" aria-label="Resources">
    <div class="container res-grid">
      <div>
        <h2>Guides for your bank</h2>
        <ul role="list">
          {banks.map((b) => <li><a href={`/convert/${b.data.slug}`}>{b.data.name}</a></li>)}
          <li><a href="/convert">All supported banks</a></li>
        </ul>
      </div>
      <div>
        <h2>How we compare</h2>
        <ul role="list">
          {comparePages.filter((c) => c.featured).map((c) => <li><a href={c.href}>{c.title}</a></li>)}
          <li><a href="/compare">All comparisons</a></li>
        </ul>
      </div>
      <div>
        <h2>Who it's for</h2>
        <ul role="list">
          <li><a href="/for/accountants">Accountants &amp; CPA firms</a></li>
          <li><a href="/for/bookkeepers">Bookkeepers</a></li>
          {useCases.map((u) => <li><a href={`/blog/${u.slug}`}>{u.post.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <SampleExport />
  <StickyCta note={`${FREE_SIGNUP_PAGES} pages free · No card`} />
</Base>

<style>
  h2 { font-size: clamp(30px, 3.6vw, 44px); margin: 0; font-weight: 800; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 28px; }

  /* Hero */
  .hero { padding-block: 36px 72px; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas: "sheet copy";
    gap: 48px;
    align-items: start;
  }
  .hero-copy { grid-area: copy; padding-top: 4px; }
  .hero-sheet { grid-area: sheet; }
  .hero-title {
    margin: 0;
    font-size: clamp(34px, 3vw, 44px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-sub { margin: 14px 0 0; font-size: 16px; line-height: 1.5; color: var(--ink-soft); max-width: 46ch; }
  .hero-upload { margin-top: 22px; }
  .hero-sample { margin: 16px 0 0; font-size: 15px; color: var(--ink-soft); }
  .hero-meta {
    display: flex; flex-wrap: wrap; gap: 6px 22px;
    margin: 14px 0 0;
    font-size: 14px; color: var(--ink-soft);
  }

  /* How it works */
  .how { padding-block: 104px 96px; }
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: center;
  }
  .how-steps { list-style: none; margin: 32px 0 0; padding: 0; border-top: 2px solid var(--ink); }
  .how-steps li {
    display: grid; grid-template-columns: 56px 1fr; gap: 8px;
    padding: 18px 0; border-bottom: 1px solid var(--rule-strong);
  }
  .how-n { font-family: var(--font-heading); font-size: 34px; font-weight: 800; line-height: 1; }
  .how-steps h3 { margin: 0 0 4px; font-size: 20px; font-weight: 800; }
  .how-steps p { margin: 0; color: var(--ink-soft); font-size: 16px; }
  .how-video { position: relative; }
  .how-video-note { margin: 0 0 8px 6px; font-size: 22px; transform: rotate(-1.5deg); transform-origin: left; }

  /* Account summary */
  .summary { padding-block: 24px 104px; }
  .summary-sheet { padding: 44px 48px 30px; }
  .summary-head { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 48px; align-items: end; padding-bottom: 22px; border-bottom: 2px solid var(--ink); }
  .summary-head p { margin: 0; color: var(--ink-soft); font-size: 17px; max-width: 46ch; }
  .summary-list { margin: 0; }
  .summary-row { display: grid; grid-template-columns: minmax(200px, 0.8fr) 2fr; gap: 8px 48px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .summary-row:last-child { border-bottom: 0; }
  .summary-row dt { font-family: var(--font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.01em; }
  .summary-row dd { margin: 0; color: var(--ink-soft); font-size: 17px; max-width: 62ch; }
  .summary-new { margin-left: 10px; font-size: 19px; }

  /* Who it's for */
  .who { padding-block: 0 104px; }
  .who-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 48px; align-items: start; }
  .who-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 2px solid var(--ink); }
  .who-list li { padding-top: 18px; }
  .who-list h3 { margin: 0 0 8px; font-size: 20px; font-weight: 800; }
  .who-list p { margin: 0 0 12px; color: var(--ink-soft); font-size: 16px; }
  .who-list a { font-weight: 600; }

  /* Fee schedule */
  .pricing { padding-block: 0 104px; }
  .fees { padding: 44px 48px 48px; }
  .fees-head { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 48px; align-items: end; padding-bottom: 22px; border-bottom: 2px solid var(--ink); }
  .fees-head p { margin: 0; color: var(--ink-soft); font-size: 17px; max-width: 50ch; }
  .fees-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fee { display: flex; flex-direction: column; padding: 28px 28px 0; border-right: 1px solid var(--rule); }
  .fee:first-child { padding-left: 0; }
  .fee:last-child { border-right: 0; padding-right: 0; }
  .fee-label { margin: 0; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-soft); font-family: var(--font-body); }
  .fee-value { margin: 8px 0 6px; font-family: var(--font-heading); font-size: 48px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .fee-value span:not(.hl):not(.fee-pencil) { font-size: 18px; font-weight: 600; color: var(--ink-soft); letter-spacing: 0; }
  .fee-tagline { margin: 0 0 16px; color: var(--ink-soft); font-size: 16px; }
  .fee-examples { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 0 0 18px; border-block: 1px solid var(--rule); }
  .fee-examples div { padding: 10px 8px 10px 0; }
  .fee-examples dt { font-family: var(--font-heading); font-size: 24px; font-weight: 800; }
  .fee-examples dd { margin: 0; font-size: 13px; color: var(--ink-soft); line-height: 1.3; }
  .fee-list { list-style: none; margin: 0 0 24px; padding: 0; flex: 1; }
  .fee-list li { padding-block: 7px; font-size: 16px; border-bottom: 1px solid var(--rule); }
  .fee-list li::before { top: 0.85em; }
  .fee-btn { width: 100%; }
  .fee-fine { margin: 10px 0 0; font-size: 14px; color: var(--ink-soft); }
  .fee-value { position: relative; }
  .fee-pencil { display: inline-block; margin-left: 12px; font-size: 20px; letter-spacing: 0; vertical-align: middle; transform: rotate(-4deg); }
  /* Lower sheets lie on the desk too: slightly turned, never flat cards */
  .summary-sheet { transform: rotate(0.35deg); }
  .fees { transform: rotate(-0.3deg); }
  .faq-list { transform: rotate(0.25deg); }

  /* FAQ */
  .faq { padding-block: 0 104px; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: 48px; align-items: start; }
  .faq-head p { margin: 16px 0 0; color: var(--ink-soft); font-size: 17px; }
  .faq-list { padding: 8px 32px; }
  .faq-item { border-bottom: 1px solid var(--rule); }
  .faq-item:last-child { border-bottom: 0; }
  .faq-item summary {
    cursor: pointer; list-style: none; padding: 18px 0;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    font-family: var(--font-heading); font-weight: 700; font-size: 18px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; font-family: var(--font-body); font-size: 24px; font-weight: 400; line-height: 1; }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item summary:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .faq-item p { margin: 0 0 20px; color: var(--ink-soft); font-size: 17px; line-height: 1.65; max-width: 68ch; }

  /* Close */
  .close { padding-block: 96px; border-top: 2px solid var(--ink); background: var(--paper); }
  .close-inner { max-width: 880px; }
  .close h2 { font-size: clamp(38px, 5vw, 68px); letter-spacing: -0.035em; line-height: 1.02; }
  .close p { margin: 18px 0 0; font-size: 19px; color: var(--ink-soft); max-width: 52ch; }
  .close-btn { min-height: 56px; font-size: 19px; padding-inline: 28px; }
  .close-note { font-size: 15px; color: var(--ink-soft); }

  /* Resources */
  .resources { padding-block: 56px; border-top: 1px solid var(--rule-strong); }
  .res-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .res-grid h2 { font-size: 15px; margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-body); font-weight: 700; }
  .res-grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; }
  .res-grid a { color: var(--ink-soft); text-decoration: none; }
  .res-grid a:hover { color: var(--ink); text-decoration: underline; }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; grid-template-areas: "copy" "sheet"; gap: 40px; }
    .summary-sheet, .fees, .faq-list { transform: none; }
    .hero-copy { max-width: 620px; }
