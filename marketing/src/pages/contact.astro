---
import Base from '../layouts/Base.astro';
import { SUPPORT_EMAIL } from '../consts';

const subjectOptions = [
  'General question',
  'Billing & account',
  'Technical / product issue',
  'Partnership or press',
];
---

<Base
  title="Help Center — Contact"
  description="Questions about Bank Statement Scanner, your account, or a technical issue? Send us a message—we read every submission."
  path="/contact"
>
  <section class="container contact">
    <nav class="contact-crumbs" aria-label="Breadcrumb"><a href="/">← Back to home</a></nav>
    <h1>Help Center</h1>
    <p class="contact-sub">
      Questions about Bank Statement Scanner, your account, or a technical issue? Send us a
      message—we read every submission.
    </p>

    <p class="contact-alert contact-alert--error" id="contact-error" role="alert" hidden></p>
    <p class="contact-alert contact-alert--ok" id="contact-success" role="status" hidden>
      Thanks for reaching out—we'll reply to the email address you provided as soon as we can.
    </p>

    <form class="contact-form" id="contact-form" novalidate>
      <div class="field field--honeypot" aria-hidden="true">
        <label for="c-company">Company</label>
        <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="c-subject">Topic</label>
        <select id="c-subject" name="subject" required>
          {subjectOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="c-message">Message</label>
        <textarea id="c-message" name="message" required rows="6" placeholder="Describe your question or issue…"></textarea>
      </div>

      <button type="submit" class="contact-submit" id="contact-submit">Send message</button>
    </form>

    <div class="contact-fallback" id="contact-fallback" hidden>
      <p>You can also email us directly—your draft is prefilled when you open the link below.</p>
      <a id="contact-mailto" href="#">Open in email app</a>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ SUPPORT_EMAIL }}>
  const topicDefault = {
    general: 'General question',
    billing: 'Billing & account',
    technical: 'Technical / product issue',
    partnership: 'Partnership or press',
    sales: 'Partnership or press',
  };

  const form = document.getElementById('contact-form');
  const errorEl = document.getElementById('contact-error');
  const successEl = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit');
  const fallback = document.getElementById('contact-fallback');
  const mailtoLink = document.getElementById('contact-mailto');
  const subjectSel = document.getElementById('c-subject');

  // Preselect topic from ?topic= query param.
  const topicKey = (new URLSearchParams(location.search).get('topic') || '').toLowerCase();
  if (topicDefault[topicKey]) subjectSel.value = topicDefault[topicKey];

  function buildMailto(v) {
    const body = `Name: ${v.name}\nEmail: ${v.email}\n\n${v.message}`;
    return `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent('[Contact] ' + v.subject)}&body=${encodeURIComponent(body)}`;
  }
  function showError(msg, mailtoVals) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
    if (mailtoVals) {
      mailtoLink.href = buildMailto(mailtoVals);
      fallback.hidden = false;
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    fallback.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const vals = {
      name: form.name.value.trim(),
      email: form.email.value.trim(),
      subject: form.subject.value,
      message: form.message.value.trim(),
      _company: form.company.value,
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(vals),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        form.hidden = true;
        successEl.hidden = false;
        return;
      }
      if (res.status === 503 && data.error === 'not_configured') {
        showError('Our contact service is momentarily unavailable.', vals);
      } else if (res.status === 400) {
        showError(
          data.error === 'invalid_email'
            ? 'Please enter a valid email address.'
            : 'Please fill in your name, email, subject, and message.'
        );
      } else {
        showError("We couldn't send your message just now. Please try again in a moment.");
      }
    } catch {
      showError('Network error—please email us directly.', vals);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message';
    }
  });
</script>

<style>
  .contact { max-width: 640px; padding-block: 40px 24px; }
  .contact-crumbs { margin-bottom: 24px; font-size: 14px; }
  .contact h1 { font-size: clamp(28px, 4vw, 38px); margin: 0 0 12px; }
  .contact-sub { color: var(--color-text-muted); font-size: 17px; margin: 0 0 28px; }

  .contact-alert { border-radius: var(--radius-md); padding: 12px 16px; font-size: 15px; margin: 0 0 20px; }
  .contact-alert--error { background: rgba(220, 38, 38, 0.06); color: var(--color-error); border: 1px solid rgba(220, 38, 38, 0.35); }
  .contact-alert--ok { background: rgba(34, 197, 94, 0.1); color: #15803d; border: 1px solid rgba(34, 197, 94, 0.4); }

  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field--honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .field label { font-weight: 600; font-size: 14px; }
  .field input, .field select, .field textarea {
    font: inherit; padding: 11px 13px; border: 1px solid var(--color-border);
    border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text);
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-subtle);
  }
  .field textarea { resize: vertical; }

  .contact-submit {
    align-self: flex-start; background: var(--color-primary); color: var(--color-on-primary);
    font: inherit; font-weight: 600; padding: 12px 24px; border: none;
    border-radius: var(--radius-md); cursor: pointer;
  }
  .contact-submit:hover { background: var(--color-primary-hover); }
  .contact-submit:disabled { opacity: 0.6; cursor: default; }

  .contact-fallback { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--color-border); }
  .contact-fallback p { margin: 0 0 10px; color: var(--color-text-muted); }
  .contact-fallback a { font-weight: 600; }
</style>
