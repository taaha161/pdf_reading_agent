---
import Base from '../layouts/Base.astro';
import { SUPPORT_EMAIL } from '../consts';

const measures = [
  {
    title: 'Encrypted in transit',
    body: 'Every upload and download happens over HTTPS (TLS). Your statement data is encrypted between your browser and our servers.',
  },
  {
    title: 'Incognito mode',
    body: 'Process a statement without saving it to your account. In incognito mode your file and its extracted data are not retained after your session.',
  },
  {
    title: 'You control retention',
    body: 'Saved jobs stay in your account until you delete them. Request full deletion of your data at any time by emailing our team.',
  },
  {
    title: 'Payments handled by Stripe',
    body: 'We never see or store your card number. All billing is processed by Stripe, a PCI-DSS Level 1 certified payment provider.',
  },
  {
    title: 'Minimal data collection',
    body: 'We collect what is needed to run the service and nothing more. What we collect, why, and how long we keep it is detailed in our Privacy Policy.',
  },
  {
    title: 'Your files, your export',
    body: 'Extracted data is yours to export as CSV or Excel. The original PDF remains your system of record; we help you produce the structured copy.',
  },
];
---

<Base
  title="Security & Privacy"
  description="How Bank Statement Scanner protects your financial data: encryption in transit, incognito processing, retention controls, and Stripe-handled payments."
  path="/security"
>
  <section class="container sec">
    <nav class="sec-crumbs" aria-label="Breadcrumb"><a href="/">← Back to home</a></nav>
    <header class="sec-head">
      <p class="eyebrow">Trust</p>
      <h1>Security &amp; privacy</h1>
      <p class="lede">
        Bank statements are sensitive. Here is plainly how we handle your data when you
        convert a statement with Bank Statement Scanner.
      </p>
    </header>

    <div class="sec-grid">
      {
        measures.map((m) => (
          <article class="sec-card">
            <h2>{m.title}</h2>
            <p>{m.body}</p>
          </article>
        ))
      }
    </div>

    <div class="sec-detail">
      <h2>How a conversion is handled</h2>
      <p>
        When you upload a statement, the file is sent over an encrypted HTTPS connection and
        processed to extract transaction dates, descriptions, and amounts. The AI reads only the
        document you provide—it does not connect to your bank and never asks for online-banking
        credentials. Once extraction finishes, you review the results and export them to CSV or
        Excel. That export is the point of the product: you keep a clean, structured copy while
        the original PDF stays your system of record.
      </p>
      <p>
        If you use incognito mode, the uploaded file and its extracted data are not retained after
        your session ends, so nothing is written to your account history. When you are signed in,
        saved jobs remain available until you delete them—so you decide how long anything is kept.
        You can request full deletion of your account and its data at any time.
      </p>
      <h2>Questions we are asked most</h2>
      <p>
        <strong>Do you sell or share my data?</strong> No. We do not sell your financial data or
        share it for advertising. We collect only what is needed to run the service, as described
        in our Privacy Policy.
      </p>
      <p>
        <strong>Who processes payments?</strong> All billing runs through Stripe, a PCI-DSS
        Level 1 certified provider. We never see or store your full card number.
      </p>
      <p>
        <strong>Can I use this for client work?</strong> Yes. Accountants and bookkeepers use it
        on client statements every day; retention controls and incognito mode let you match your
        own data-handling policies.
      </p>
    </div>

    <div class="sec-foot">
      <p>
        Have a security question, need a data-deletion request, or want details for a vendor
        review? Email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or
        <a href="/contact">contact support</a>. For the full legal detail, see our
        <a href="/privacy-policy">Privacy Policy</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .sec { max-width: 900px; padding-block: 40px 24px; }
  .sec-crumbs { margin-bottom: 24px; font-size: 14px; }
  .sec-head { max-width: 640px; margin-bottom: 40px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 13px; font-weight: 600; color: var(--color-primary); margin: 0 0 10px; }
  .sec-head h1 { font-size: clamp(30px, 5vw, 44px); margin: 0; }
  .lede { color: var(--color-text-muted); font-size: 18px; margin-top: 14px; }

  .sec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .sec-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm);
  }
  .sec-card h2 { font-size: 19px; margin: 0 0 8px; }
  .sec-card p { color: var(--color-text-muted); font-size: 15px; margin: 0; line-height: 1.6; }

  .sec-detail { margin-top: 40px; max-width: 720px; }
  .sec-detail h2 { font-size: 22px; margin: 28px 0 12px; }
  .sec-detail p { color: var(--color-text-muted); font-size: 16px; line-height: 1.7; margin: 0 0 14px; }
  .sec-detail strong { color: var(--color-text); }

  .sec-foot {
    margin-top: 36px; padding: 22px 24px; background: var(--color-primary-subtle);
    border-radius: var(--radius-lg); font-size: 16px;
  }
  .sec-foot p { margin: 0; }
</style>
