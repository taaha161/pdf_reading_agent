---
import logo from '../assets/pdf_to_excel_logo.png';
import { Image } from 'astro:assets';
---

<header class="mkt-header">
  <nav class="mkt-nav container" aria-label="Primary">
    <a class="mkt-brand" href="/">
      <span class="mkt-brand-icon" aria-hidden="true">
        <Image src={logo} alt="" width={28} height={28} />
      </span>
      <span class="mkt-brand-name">Bank Statement Scanner</span>
    </a>

    <input type="checkbox" id="mkt-nav-toggle" class="mkt-nav-toggle" hidden />
    <label class="mkt-hamburger" for="mkt-nav-toggle" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <div class="mkt-nav-body">
      <div class="mkt-nav-links">
        <a class="mkt-nav-link" href="/#how-it-works">How it works</a>
        <a class="mkt-nav-link" href="/#results">Results</a>
        <a class="mkt-nav-link" href="/#pricing">Pricing</a>
        <a class="mkt-nav-link" href="/blog">Blog</a>
        <a class="mkt-nav-link" href="/contact">Support</a>
      </div>
      <div class="mkt-nav-actions">
        <a class="mkt-nav-login" href="/login">Log in</a>
        <a class="mkt-nav-cta" href="/scanner">Get started free</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .mkt-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .mkt-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .mkt-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    font-weight: 700;
    margin-right: auto;
  }
  .mkt-brand-icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
  }
  .mkt-brand-name {
    font-family: var(--font-heading);
    font-size: 17px;
  }
  .mkt-nav-body {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .mkt-nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .mkt-nav-link {
    color: var(--color-text-muted);
    font-size: 15px;
    font-weight: 500;
  }
  .mkt-nav-link:hover {
    color: var(--color-text);
  }
  .mkt-nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .mkt-nav-login {
    color: var(--color-text);
    font-weight: 600;
    font-size: 15px;
  }
  .mkt-nav-cta {
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 600;
    font-size: 15px;
    padding: 9px 16px;
    border-radius: var(--radius-md);
  }
  .mkt-nav-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
  }
  .mkt-hamburger {
    display: none;
  }

  @media (max-width: 820px) {
    .mkt-hamburger {
      display: inline-flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 8px;
    }
    .mkt-hamburger span {
      width: 22px;
      height: 2px;
      background: var(--color-text);
      border-radius: 2px;
    }
    .mkt-nav-body {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding-bottom: 18px;
    }
    .mkt-nav-toggle:checked ~ .mkt-nav-body {
      display: flex;
    }
    .mkt-nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .mkt-nav-actions {
      justify-content: flex-start;
    }
  }
</style>
