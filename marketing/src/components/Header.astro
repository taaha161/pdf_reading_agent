---
import LogoMark from './LogoMark.astro';
---

<header class="mkt-header">
  <nav class="mkt-nav container" aria-label="Primary">
    <a class="mkt-brand" href="/">
      <LogoMark />
      <span class="mkt-brand-name">Bank Statement Scanner</span>
    </a>

    <button
      type="button"
      class="mkt-menu-btn"
      aria-expanded="false"
      aria-controls="mkt-nav-body"
      data-nav-toggle
    >
      <span class="mkt-menu-bars" aria-hidden="true"><span></span><span></span></span>
      <span class="mkt-menu-label">Menu</span>
    </button>

    <div class="mkt-nav-body" id="mkt-nav-body" data-nav-body>
      <div class="mkt-nav-links">
        <a class="mkt-nav-link" href="/#how-it-works">How it works</a>
        <a class="mkt-nav-link" href="/#pricing">Pricing</a>
        <a class="mkt-nav-link" href="/convert">Banks</a>
        <a class="mkt-nav-link" href="/security">Security</a>
      </div>
      <div class="mkt-nav-actions">
        <a class="mkt-nav-login" href="/login" data-nav-login>Log in</a>
        <a class="ink-btn mkt-nav-cta" href="/scanner" data-cta="nav">Convert a statement free</a>
      </div>
      <!-- The app (proxied on this origin) keeps its Supabase session in localStorage.
           If one exists, swap "Log in" for a link back into the app. Inline and right
           after the link so the swap happens before first paint, with no flash. -->
      <script is:inline>
        (function () {
          try {
            for (var i = 0; i < localStorage.length; i++) {
              var k = localStorage.key(i);
              if (!/^sb-.+-auth-token$/.test(k)) continue;
              var s = JSON.parse(localStorage.getItem(k) || "null");
              s = s && (s.currentSession || s);
              // A refresh token means the app can renew the session even if the access token expired.
              if (s && s.refresh_token) {
                var a = document.querySelector("[data-nav-login]");
                if (a) { a.textContent = "Open app"; a.setAttribute("href", "/scanner"); }
                return;
              }
            }
          } catch (e) {}
        })();
      </script>
    </div>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const body = document.querySelector<HTMLElement>('[data-nav-body]');
  if (btn && body) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      body.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    body.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) set(false);
    });
  }
</script>

<style>
  .mkt-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--desk);
    border-bottom: 2px solid var(--ink);
  }
  .mkt-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .mkt-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .mkt-brand-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .mkt-nav-body {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .mkt-nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .mkt-nav-link,
  .mkt-nav-login {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .mkt-nav-link:hover,
  .mkt-nav-login:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .mkt-nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .mkt-nav-cta {
    min-height: 42px;
    padding: 8px 16px;
    font-size: 15px;
  }
  .mkt-menu-btn {
    display: none;
  }

  @media (max-width: 1000px) {
    .mkt-nav { gap: 12px; flex-wrap: wrap; }
    .mkt-brand { min-width: 0; }
    .mkt-menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 8px 12px;
      background: transparent;
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      color: var(--ink);
      font: 700 15px/1 var(--font-heading);
      cursor: pointer;
    }
    .mkt-menu-bars {
      display: inline-flex;
      flex-direction: column;
      gap: 4px;
    }
    .mkt-menu-bars span {
      width: 18px;
      height: 2px;
      background: var(--ink);
    }
    .mkt-nav-body {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      padding: 8px 0 20px;
    }
    .mkt-nav-body.is-open {
      display: flex;
    }
    .mkt-nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .mkt-nav-link {
      font-size: 18px;
    }
    .mkt-nav-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .mkt-nav-cta {
      min-height: 48px;
    }
  }
  @media (max-width: 420px) {
    .mkt-brand-name { font-size: 16px; }
    .mkt-menu-btn { padding: 8px 10px; }
  }
</style>
