---
/**
 * Real upload box on marketing pages. A dropped or picked file is stored in IndexedDB
 * (same origin as /scanner, which Vercel proxies to the app) and the scanner page picks
 * it up on load and starts the scan. See frontend/src/lib/fileHandoff.js.
 *
 * Dropping a file anywhere on the page also lands here, so a stray drop never opens the
 * PDF in the browser and takes the visitor off the site.
 */
import { MAX_UPLOAD_MB_GUEST, MAX_UPLOAD_MB_PAID } from '../consts';

interface Props {
  hint?: string;
  cta?: string;
  /** Extra query string for the /scanner redirect, e.g. "offer=linkedin1m". */
  params?: string;
}
const {
  hint = 'Supports Chase, Wells Fargo, Amex, and 100+ more institutions.',
  cta = 'hero',
  params = '',
} = Astro.props;
---

<div class="upload-card" data-dropzone data-cta-name={cta} data-params={params} data-max-mb={MAX_UPLOAD_MB_PAID}>
  <div class="upload-drop" role="button" tabindex="0" aria-describedby="dz-hint dz-limits" aria-label="Choose a bank statement PDF to convert">
    <span class="upload-title" data-dz-title>
      <span class="upload-title-pointer">Drop a statement PDF here</span>
      <span class="upload-title-touch">Choose a statement PDF</span>
    </span>
    <span class="upload-hint" id="dz-hint">{hint}</span>
    <span class="ink-btn upload-btn">Convert a statement free</span>
    <span class="upload-limits" id="dz-limits">PDF only, digital or scanned · Up to {MAX_UPLOAD_MB_GUEST} MB free, {MAX_UPLOAD_MB_PAID} MB on Monthly</span>
  </div>
  <p class="upload-error" data-dz-error role="alert" hidden></p>
  <input type="file" accept="application/pdf,.pdf" data-dz-input hidden />
</div>

<script>
  import { handOffFile } from '../lib/fileHandoff';

  const zone = document.querySelector<HTMLElement>('[data-dropzone]');
  if (zone) {
    // Largest file any plan accepts; /scanner then checks this visitor's own limit.
    const maxMb = Number(zone.dataset.maxMb) || 50;
    const MAX_BYTES = maxMb * 1024 * 1024;
    const drop = zone.querySelector<HTMLElement>('.upload-drop')!;
    const input = zone.querySelector<HTMLInputElement>('[data-dz-input]')!;
    const title = zone.querySelector<HTMLElement>('[data-dz-title]')!;
    const err = zone.querySelector<HTMLElement>('[data-dz-error]')!;
    const cta = zone.dataset.ctaName || 'hero';
    let busy = false;

    const push = (data: Record<string, unknown>) => {
      try { ((window as any).dataLayer = (window as any).dataLayer || []).push(data); } catch {}
    };
    const showError = (msg: string) => { err.textContent = msg; err.hidden = false; };

    const accept = async (file: File | undefined, how: 'drop' | 'pick') => {
      if (!file || busy) return;
      err.hidden = true;
      const ok = file.type === 'application/pdf' || /\.pdf$/i.test(file.name);
      if (!ok) return showError('Only PDF files are supported. Scan paper statements or photos to PDF first.');
      if (file.size > MAX_BYTES) return showError(`That file is over ${maxMb} MB, the largest we accept. Try splitting it into smaller PDFs.`);
      busy = true;
      zone.classList.add('is-busy');
      title.textContent = `Opening ${file.name}…`;
      push({ event: 'hero_drop', cta, method: how, file_type: file.type || 'unknown' });
      const stored = await handOffFile(file);
      // If storage is blocked (private mode etc.), still go to the scanner; they re-pick the file there.
      const query = [stored ? 'handoff=1' : '', zone.dataset.params || ''].filter(Boolean).join('&');
      window.location.href = query ? `/scanner?${query}` : '/scanner';
    };

    drop.addEventListener('click', () => input.click());
    drop.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
    });
    input.addEventListener('change', () => accept(input.files?.[0], 'pick'));

    // Whole-window drop target: highlight the card while a file is dragged over the page.
    let depth = 0;
    const hasFiles = (e: DragEvent) => !!e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files');
    window.addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return;
      depth++;
      zone.classList.add('is-over');
    });
    window.addEventListener('dragleave', () => {
      depth = Math.max(0, depth - 1);
      if (depth === 0) zone.classList.remove('is-over');
    });
    window.addEventListener('dragover', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
    });
    window.addEventListener('drop', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      depth = 0;
      zone.classList.remove('is-over');
      accept(e.dataTransfer?.files?.[0], 'drop');
    });
  }
</script>

<style>
  .upload-card {
    display: block;
    color: inherit;
  }
  .upload-drop {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px 24px 22px;
    background: var(--paper);
    border: 2px dashed var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: var(--sheet-shadow);
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .upload-drop:hover,
  .upload-card.is-over .upload-drop {
    background: var(--hi-soft);
  }
  .upload-card.is-over .upload-drop {
    border-style: solid;
  }
  .upload-card.is-busy .upload-drop {
    cursor: progress;
  }
  .upload-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .upload-title-touch { display: none; }
  @media (hover: none) and (pointer: coarse) {
    .upload-title-pointer { display: none; }
    .upload-title-touch { display: inline; }
  }
  .upload-hint {
    font-size: 15px;
    color: var(--ink-soft);
  }
  .upload-btn {
    margin-top: 6px;
    width: 100%;
  }
  .upload-drop:hover .upload-btn {
    background: #000;
    color: var(--hi);
  }
  .upload-limits {
    font-size: 14px;
    color: var(--ink-soft);
  }
  .upload-error {
    margin: 10px 0 0;
    padding: 10px 12px;
    background: var(--paper);
    border: 1px solid var(--color-error);
    color: var(--color-error);
    font-size: 15px;
    font-weight: 600;
  }
  .upload-error[hidden] { display: none; }
</style>
