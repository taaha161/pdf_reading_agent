---
import LogoMark from './LogoMark.astro';
import { SUPPORT_EMAIL, LEGAL_ENTITY } from '../consts';
import { PERSONAS } from '../personas';
const year = new Date().getFullYear();
---

<footer class="mkt-footer">
  <div class="container mkt-footer-inner">
    <div class="mkt-footer-top">
      <div class="mkt-footer-brand">
        <span class="mkt-footer-icon" aria-hidden="true">
          <LogoMark size={32} />
        </span>
        <div class="mkt-footer-brand-text">
          <span>Bank Statement Scanner</span>
          <p>Turn messy bank statements into structured data in seconds.</p>
        </div>
      </div>
      <div class="mkt-footer-columns">
        <div class="mkt-footer-col">
          <h3>Product</h3>
          <a href="/#how-it-works">How it works</a>
          <a href="/#pricing">Pricing</a>
          <a href="/blog">Blog</a>
          <a href="/convert">Supported banks</a>
          <a href="/compare">Compare</a>
        </div>
        <div class="mkt-footer-col">
          <h3>Who it's for</h3>
          {PERSONAS.map((p) => <a href={`/for/${p.slug}`}>{p.name}</a>)}
          <a href="/for">All use cases</a>
        </div>
        <div class="mkt-footer-col">
          <h3>Company</h3>
          <a href="/about">About</a>
          <a href="/rss.xml">RSS feed</a>
        </div>
        <div class="mkt-footer-col">
          <h3>Legal</h3>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms-of-service">Terms of Service</a>
          <a href="/security">Security</a>
        </div>
        <div class="mkt-footer-col">
          <h3>Support</h3>
          <a href="/contact">Help Center</a>
          <a href={`mailto:${SUPPORT_EMAIL}`}>Email support</a>
        </div>
      </div>
    </div>
    <div class="mkt-footer-meta">
      © {year} {LEGAL_ENTITY}. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .mkt-footer {
    background: var(--desk);
    border-top: 2px solid var(--ink);
  }
  .mkt-footer-inner {
    padding-block: 48px 32px;
  }
  .mkt-footer-top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .mkt-footer-brand {
    display: flex;
    gap: 12px;
    max-width: 300px;
  }
  .mkt-footer-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }
  .mkt-footer-brand-text span {
    font-family: var(--font-heading);
    font-weight: 800;
    display: block;
  }
  .mkt-footer-brand-text p {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 6px 0 0;
  }
  .mkt-footer-columns {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }
  .mkt-footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mkt-footer-col h3 {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 4px;
  }
  .mkt-footer-col a {
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }
  .mkt-footer-col a:hover {
    text-decoration: underline;
  }
  .mkt-footer-meta {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-soft);
    font-size: 14px;
  }
</style>
