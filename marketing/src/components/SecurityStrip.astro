---
/** Short security reassurance right under the hero. Every claim mirrors /security. */
interface Props {
  tone?: 'plain' | 'tint';
  /** Render as a boxed card inside an existing container (e.g. bank pages). */
  inset?: boolean;
}
const { tone = 'plain', inset = false } = Astro.props;
const svg = (d: string) =>
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const items = [
  { icon: svg('<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'), title: 'Encrypted in transit', body: 'HTTPS from your browser to our servers' },
  { icon: svg('<path d="M3 3l18 18"/><path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6 0 10 7 10 7a17 17 0 0 1-3.2 3.9M6.6 6.6A17 17 0 0 0 2 12s4 7 10 7a9.7 9.7 0 0 0 4.4-1.1"/>'), title: 'Incognito mode', body: 'Convert without saving the file or data' },
  { icon: svg('<path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/>'), title: 'You control retention', body: 'Delete saved jobs any time' },
  { icon: svg('<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="m9 12 2 2 4-4"/>'), title: 'No bank login needed', body: 'We read the PDF, never your bank account' },
];
---

<section class:list={['sec', `sec--${tone}`, { 'sec--inset': inset }]} aria-label="Security">
  <div class:list={['sec-inner', { container: !inset }]}>
    <ul class="sec-list" role="list">
      {items.map((i) => (
        <li>
          <span class="sec-icon" set:html={i.icon} />
          <span><strong>{i.title}</strong><span class="sec-body">{i.body}</span></span>
        </li>
      ))}
    </ul>
    <a class="sec-more" href="/security" data-cta="security_strip">How we protect your data →</a>
  </div>
</section>

<style>
  .sec { padding-block: 22px; border-bottom: 1px solid var(--color-border); }
  .sec--inset { margin-top: 28px; padding: 18px; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .sec--inset .sec-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sec--tint { background: var(--color-bg); border-block: 1px solid var(--color-border); }
  .sec-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; }
  .sec-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 24px; flex: 1; }
  .sec-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.4; }
  .sec-list strong { display: block; font-size: 14px; }
  .sec-body { color: var(--color-text-muted); font-size: 13px; }
  .sec-icon { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: #dcfce7; color: #15803d; }
  .sec-more { font-size: 14px; font-weight: 600; white-space: nowrap; }
  @media (max-width: 900px) { .sec-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .sec-list { grid-template-columns: 1fr; } }
</style>
