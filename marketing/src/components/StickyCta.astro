---
/**
 * Mobile-only CTA bar that slides up once the visitor scrolls past the element with
 * [data-sticky-after] (usually the hero), so the next step is always one thumb away.
 */
interface Props { href?: string; label?: string; note?: string }
const { href = '/scanner', label = 'Convert a statement free', note } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta aria-hidden="true">
  <a class="sticky-btn" href={href} data-cta="sticky" tabindex="-1">{label} →</a>
  {note && <span class="sticky-note">{note}</span>}
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const anchor = document.querySelector('[data-sticky-after]');
  if (bar && anchor && 'IntersectionObserver' in window) {
    const link = bar.querySelector('a')!;
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('is-on', show);
      bar.setAttribute('aria-hidden', String(!show));
      link.tabIndex = show ? 0 : -1;
    }).observe(anchor);
  }
</script>

<style>
  .sticky-cta {
    display: none; position: fixed; inset: auto 0 0 0; z-index: 60; padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.97); border-top: 1px solid var(--color-border); backdrop-filter: blur(8px);
    transform: translateY(110%); transition: transform 0.2s ease; text-align: center;
  }
  .sticky-cta.is-on { transform: translateY(0); }
  .sticky-btn {
    display: block; font-weight: 700; font-size: 16px; padding: 13px 18px; border-radius: var(--radius-md);
    background: var(--color-primary); color: var(--color-on-primary);
  }
  .sticky-btn:hover { color: var(--color-on-primary); background: var(--color-primary-hover); }
  .sticky-note { display: block; margin-top: 4px; font-size: 12px; color: var(--color-text-muted); }
  @media (max-width: 760px) { .sticky-cta { display: block; } }
  @media (prefers-reduced-motion: reduce) { .sticky-cta { transition: none; } }
</style>
