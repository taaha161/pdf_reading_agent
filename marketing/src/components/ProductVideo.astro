---
/**
 * 22s product video (from /brag). Plays muted + looped while on screen, pauses off screen.
 * "Watch with sound" restarts it from the top with audio and native controls.
 * Nothing downloads until the section is near the viewport (preload="none" + IntersectionObserver).
 * Reduced-motion visitors get the poster and a play button instead of autoplay.
 */
const SRC = '/video/product-demo.mp4';
const POSTER = '/video/product-demo-poster.webp';
---

<div class="pv" data-pv>
  <video
    class="pv-video"
    poster={POSTER}
    muted
    loop
    playsinline
    preload="none"
    width="1920"
    height="1080"
    aria-label="22-second product demo: a PDF bank statement is dropped in, every transaction is extracted and categorized, balances are checked, and the result is downloaded as Excel or CSV"
  >
    <source src={SRC} type="video/mp4" />
  </video>
  <button type="button" class="pv-sound" data-pv-sound data-cta="video_sound">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
    </svg>
    <span>Watch with sound</span>
  </button>
</div>

<script>
  type DL = { push: (o: Record<string, unknown>) => void };
  const track = (event: string, extra: Record<string, unknown> = {}) => {
    const w = window as unknown as { dataLayer?: DL & unknown[] };
    (w.dataLayer = w.dataLayer || ([] as unknown as DL & unknown[])).push({ event, video: 'product_demo', ...extra });
  };

  document.querySelectorAll<HTMLElement>('[data-pv]').forEach((root) => {
    const video = root.querySelector('video')!;
    const sound = root.querySelector<HTMLButtonElement>('[data-pv-sound]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let withSound = false;
    let seen = false;

    if (reduced) {
      // No autoplay: the sound button doubles as the play button.
      sound.querySelector('span')!.textContent = 'Play video';
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (withSound) {
            if (!entry.isIntersecting) video.pause();
            return;
          }
          if (entry.isIntersecting) {
            video.play().catch(() => {});
            if (!seen) { seen = true; track('video_autoplay_view'); }
          } else {
            video.pause();
          }
        },
        { threshold: 0.5 },
      ).observe(video);
    }

    sound.addEventListener('click', () => {
      withSound = true;
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.currentTime = 0;
      video.play().catch(() => {});
      root.classList.add('pv--sound');
      track('video_play_sound');
    });

    video.addEventListener('ended', () => {
      if (withSound) track('video_complete');
    });
  });
</script>

<style>
  .pv {
    position: relative; border-radius: 16px; overflow: hidden; background: #f8fafc;
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.16), 0 4px 12px rgba(15, 23, 42, 0.06);
  }
  .pv-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #f8fafc; }
  .pv-sound {
    position: absolute; right: 16px; bottom: 16px;
    display: inline-flex; align-items: center; gap: 8px;
    font: inherit; font-size: 14px; font-weight: 600; color: #fff;
    background: rgba(15, 23, 42, 0.78); backdrop-filter: blur(6px);
    border: 0; border-radius: 999px; padding: 10px 16px; cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .pv-sound:hover { background: var(--color-primary); transform: translateY(-1px); }
  .pv-sound:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .pv--sound .pv-sound { display: none; }

  @media (max-width: 560px) {
    .pv { border-radius: 12px; }
    .pv-sound { right: 10px; bottom: 10px; padding: 8px 12px; font-size: 13px; }
  }
</style>
