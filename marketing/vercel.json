{
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://app.bankstatementscanner.com/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://app.bankstatementscanner.com/assets/:path*" },
    { "source": "/auth-avatars/:path*", "destination": "https://app.bankstatementscanner.com/auth-avatars/:path*" },
    { "source": "/auth-illustration.svg", "destination": "https://app.bankstatementscanner.com/auth-illustration.svg" },
    { "source": "/scanner", "destination": "https://app.bankstatementscanner.com/scanner" },
    { "source": "/scanner/:path*", "destination": "https://app.bankstatementscanner.com/scanner/:path*" },
    { "source": "/dashboard", "destination": "https://app.bankstatementscanner.com/dashboard" },
    { "source": "/settings", "destination": "https://app.bankstatementscanner.com/settings" },
    { "source": "/login", "destination": "https://app.bankstatementscanner.com/login" },
    { "source": "/signup", "destination": "https://app.bankstatementscanner.com/signup" },
    { "source": "/forgot-password", "destination": "https://app.bankstatementscanner.com/forgot-password" },
    { "source": "/reset-password", "destination": "https://app.bankstatementscanner.com/reset-password" }
  ]
}
